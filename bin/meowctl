MEOW="${MEOW:-$HOME/.meow}"

if [ -f "./config/env/env.sh" ] && [ -d "./presets" ]; then
  MEOW="$(pwd)"
fi

source "${MEOW}/lib/env/env.sh"

# Source user settings from .meowrc if it exists
if [ -f "$HOME/.meowrc" ]; then
  source "$HOME/.meowrc"
fi

source "${MEOW}/lib/core/bash.sh"
source "${MEOW}/lib/core/ui.sh"
source "${MEOW}/lib/core/dry_run.sh"

# Source config library if available
if [ -f "${MEOW}/lib/config/config.sh" ]; then
  source "${MEOW}/lib/config/config.sh"
fi

show_main_help() {
  ui_title "meowctl - Unified meow control"
  ui_message "Manage your meow dotfiles and development environment."
  ui_message ""
  ui_message "Usage: $0 <command> [options] [arguments]"
  ui_message ""
  ui_message "Commands:"
  ui_message "  install <preset>         Install a preset"
  ui_message "  update [preset]          Update preset or all installed components"
  ui_message "  uninstall <preset>       Uninstall a preset (or 'all' for all presets)"
  ui_message "  list                     List available presets"
  ui_message "  component <subcommand>   Manage components"
  ui_message "  config <subcommand>      Manage meow configuration"
  ui_message "  theme <subcommand>       Manage themes (alias for theme-manager)"
  ui_message "  backup <subcommand>      Manage symlink backups"
  ui_message "  help [command]           Show help for command"
  ui_message ""
  ui_message "Global Options:"
  ui_message "  --verbose, -v            Show detailed output"
  ui_message "  --dry-run                Show what would be done without making changes"
  ui_message "  --help, -h               Show help"
  ui_message ""
  ui_message "Examples:"
  ui_message "  $0 install personal"
  ui_message "  $0 install personal --verbose"
  ui_message "  $0 install personal --dry-run"
  ui_message "  $0 update --pull"
  ui_message "  $0 list"
  ui_message "  $0 component list"
  ui_message "  $0 backup list"
  ui_message ""
}

