  ui_message "Examples:"
  ui_message "  $0 backup list"
  ui_message "  $0 backup restore .vimrc.backup.20231201_120000"
  ui_message ""
}

parse_global_options() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v)
        export MEOW_VERBOSE="true"
        shift
        ;;
      --dry-run)
        export MEOW_DRY_RUN="true"
        shift
        ;;
      --help | -h)
        echo "help"
        return
        ;;
      --*)
        ui_error "Unknown global option: $1"
        exit 1
        ;;
      *)
        echo "$@"
        return
        ;;
    esac
  done
}

validate_preset_name() {
  local preset="$1"

  if [ -z "$preset" ]; then
    ui_error "Preset name cannot be empty"
    return 1
  fi

  if ! echo "$preset" | grep -qE '^[a-zA-Z0-9_-]+$'; then
    ui_error "Invalid preset name '$preset'. Use only alphanumeric characters, underscores, and dashes."
    return 1
  fi

  local preset_file="${MEOW}/presets/${preset}/preset.yaml"
  if [ ! -f "$preset_file" ]; then
    ui_error "Preset '$preset' not found"
    return 1
  fi

  return 0
}

validate_component_name() {
  local component="$1"

  if [ -z "$component" ]; then
    ui_error "Component name cannot be empty"
    return 1
  fi

  if ! echo "$component" | grep -qE '^[a-zA-Z0-9_-]+$'; then
    ui_error "Invalid component name '$component'. Use only alphanumeric characters, underscores, and dashes."
    return 1
  fi

  return 0
}

cmd_component() {
  local subcommand="${1:-}"

  case "$subcommand" in
    --verbose | -v)
      export MEOW_VERBOSE="true"
      subcommand="${2:-}"
      shift 2
      ;;
    --dry-run)
      export MEOW_DRY_RUN="true"
      subcommand="${2:-}"
      shift 2
      ;;
    --help | -h)
      show_component_help
      exit 0
      ;;
    "")
      ui_error "No component subcommand specified"
      show_component_help
      exit 1
      ;;
    *)
      shift
      ;;
  esac

  source "${MEOW}/lib/components/components.sh"

  case "$subcommand" in
    list)
      local show_simple="false"
      while [ $# -gt 0 ]; do
        case "$1" in
          --names-only)
            show_simple="true"
            shift
            ;;
          --help | -h)
            show_component_help
            exit 0
            ;;
          *)
            ui_error "Unknown option for component list: $1"
            exit 1
            ;;
        esac
      done

      if [ "$show_simple" = "true" ]; then
        list_components false false # show_installed_only=false, show_verbose=false
      else
        list_components false true # show_installed_only=false, show_verbose=true
      fi
      ;;
    install)
      local install_args=()
      local install_components=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --verbose | -v)
            export MEOW_VERBOSE="true"
            shift
            ;;
          --dry-run)
            export MEOW_DRY_RUN="true"
            shift
            ;;
          --force)
            install_args+=("--force")
            shift
            ;;
          *)
            install_args+=("$1")
            install_components+=("$1")
            shift
            ;;
        esac
      done

      if [ ${#install_components[@]} -eq 0 ]; then
        ui_error "No components specified for install command"
        exit 1
      fi

      # Validate all component names first
      for component in "${install_components[@]}"; do
        if ! validate_component_name "$component"; then
          exit 1
        fi
      done

      reset_summary_counters

      local start_time
      start_time=$(date +%s)

      local install_result=0
      install_component --manual "${install_args[@]}" || install_result=$?

      if [ "$install_result" -eq 0 ]; then
        show_final_summary "Component installation" "${install_args[*]}" "true" "$start_time"
        exit 0
      else
        show_final_summary "Component installation" "${install_args[*]}" "false" "$start_time"
        exit 1
      fi
      ;;
    uninstall)
      local force_flag=""
      local component=""

      while [ $# -gt 0 ]; do
        case "$1" in
          --verbose | -v)
            export MEOW_VERBOSE="true"
            shift
            ;;
          --dry-run)
            export MEOW_DRY_RUN="true"
            shift
            ;;
          --force)
            force_flag="--force"
            shift
            ;;
          *)
            if [ -z "$component" ]; then
              component="$1"
            else
              ui_error "Too many arguments for component uninstall command"
              exit 1
            fi
            shift
            ;;
        esac
      done

      if [ -z "$component" ]; then
        ui_error "No component specified for uninstall command"
        exit 1
      fi

      if ! validate_component_name "$component"; then
        exit 1
      fi

      reset_summary_counters

      local start_time
      start_time=$(date +%s)

      if [ -n "$force_flag" ]; then
        if uninstall_component "$component" "$force_flag"; then
          show_final_summary "Component uninstall" "$component" "true" "$start_time"
          exit 0
        else
          show_final_summary "Component uninstall" "$component" "false" "$start_time"
          exit 1
        fi
      else
        if uninstall_component "$component"; then
          show_final_summary "Component uninstall" "$component" "true" "$start_time"
          exit 0
        else
          show_final_summary "Component uninstall" "$component" "false" "$start_time"
          exit 1
        fi
      fi
      ;;
    update)
      local update_args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --verbose | -v)
            export MEOW_VERBOSE="true"
            shift
            ;;
          --dry-run)
            export MEOW_DRY_RUN="true"
            shift
            ;;
          *)
            update_args+=("$1")
            shift
            ;;
        esac
      done

      if [ ${#update_args[@]} -eq 0 ]; then
        ui_error "No components specified for update command"
        exit 1
      fi

      # Validate all component names first
      for component in "${update_args[@]}"; do
        if ! validate_component_name "$component"; then
          exit 1
        fi
      done

      reset_summary_counters

      local start_time
      start_time=$(date +%s)

      if update_component "${update_args[@]}"; then
        show_final_summary "Component update" "${update_args[*]}" "true" "$start_time"
        exit 0
      else
        show_final_summary "Component update" "${update_args[*]}" "false" "$start_time"
        exit 1
      fi
      ;;
    *)
      ui_error "Unknown component subcommand: $subcommand"
      show_component_help
      exit 1
      ;;
  esac
}

cmd_install() {
  local preset=""
  local force_flag=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v)
        export MEOW_VERBOSE="true"
        shift
        ;;
      --dry-run)
        export MEOW_DRY_RUN="true"
        shift
        ;;
      --force)
        force_flag="--force"
        shift
        ;;
      --help | -h)
        show_install_help
        exit 0
        ;;
      --*)
        ui_error "Unknown install option: $1"
        exit 1
        ;;
      *)
        if [ -z "$preset" ]; then
          preset="$1"
        else
          ui_error "Too many arguments for install command"
          exit 1
        fi
        shift
        ;;
    esac
  done

  if [ -z "$preset" ]; then
    ui_error "No preset specified"
    show_install_help
    exit 1
  fi

  source "${MEOW}/lib/presets/presets.sh"
  reset_summary_counters

  local start_time
  start_time=$(date +%s)

  if install_preset "$preset" "$force_flag"; then
    show_final_summary "Installation" "$preset" "true" "$start_time"
    exit 0
  else
    show_final_summary "Installation" "$preset" "false" "$start_time"
    exit 1
  fi
}

cmd_uninstall() {
  local preset=""
  local force_flag=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v)
        export MEOW_VERBOSE="true"
        shift
        ;;
      --dry-run)
        export MEOW_DRY_RUN="true"
        shift
        ;;
      --force)
        force_flag="--force"
        shift
        ;;
      --help | -h)
        show_uninstall_help
        exit 0
        ;;
      --*)
        ui_error "Unknown uninstall option: $1"
        exit 1
        ;;
      *)
        if [ -z "$preset" ]; then
          preset="$1"
        else
          ui_error "Too many arguments for uninstall command"
          exit 1
        fi
        shift
        ;;
    esac
  done

  if [ -z "$preset" ]; then
    ui_error "No preset specified"
    show_uninstall_help
    exit 1
  fi

  source "${MEOW}/lib/presets/presets.sh"
  reset_summary_counters

  local start_time
  start_time=$(date +%s)

  local uninstall_success=true
  if [ "$preset" = "all" ]; then
    if ! uninstall_all; then
      uninstall_success=false
    fi
  else
    if ! uninstall_preset "$preset" "$force_flag"; then
      uninstall_success=false
    fi
  fi

  show_final_summary "Uninstall" "$preset" "$uninstall_success" "$start_time"
  if [ "$uninstall_success" = "true" ]; then
    exit 0
  else
    exit 1
  fi
}

cmd_list() {
  case "${1:-}" in
    --help | -h)
      show_list_help
      exit 0
      ;;
    --*)
      ui_error "Unknown list option: $1"
      exit 1
      ;;
    "") ;;
    *)
      ui_error "Too many arguments for list command"
      exit 1
      ;;
  esac

  source "${MEOW}/lib/presets/presets.sh"
  list_presets
}

cmd_update() {
  local preset=""
  local pull=false
  local extra_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v)
        export MEOW_VERBOSE="true"
        shift
        ;;
      --dry-run)
        export MEOW_DRY_RUN="true"
        shift
        ;;
      --help | -h)
        show_update_help
        exit 0
        ;;
      --pull)
        if [ "$pull" = true ]; then
          ui_warning "Multiple --pull flags specified, ignoring duplicates"
        fi
        pull=true
        shift
        ;;
      --*)
        ui_error "Unknown update option: $1"
        exit 1
        ;;
      *)
        if [ -z "$preset" ]; then
          preset="$1"
        else
          extra_args+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [ ${#extra_args[@]} -gt 0 ]; then
    ui_error "Too many arguments for update command: ${extra_args[*]}"
    exit 1
  fi

  if [ -n "$preset" ] && [ "$preset" != "all" ] && ! validate_preset_name "$preset"; then
    exit 1
  fi

  reset_summary_counters

  if [ "$pull" = true ]; then
    step_header "Updating meow repository"

    if ! git -C "$MEOW" rev-parse --git-dir >/dev/null 2>&1; then
      ui_error "Not a git repository: $MEOW"
      show_final_summary "Update" "$preset" "false"
      exit 1
    fi

    if ! git -C "$MEOW" diff-index --quiet HEAD -- 2>/dev/null; then
      ui_error "You have uncommitted changes in $MEOW"
      ui_error "Please commit or stash them before updating"
      show_final_summary "Update" "$preset" "false"
      exit 1
    fi

    if dry_run_git_operation "pull" "$MEOW"; then
      :
    else
      ui_spinner "Updating meow repository" \
        --ui_success "Repository updated successfully" \
        --fail "Failed to update repository" \
        git -C "$MEOW" pull

      if [ $? -ne 0 ]; then
        ui_error "You may need to resolve merge conflicts manually"
        show_final_summary "Update" "$preset" "false"
        exit 1
      fi
    fi
  fi

  source "${MEOW}/lib/presets/presets.sh"

  local update_success=true
  if [ -n "$preset" ] && [ "$preset" != "all" ]; then
    if ! update_preset "$preset"; then
      update_success=false
    fi
  elif [ "$preset" = "all" ]; then
    if ! update_all_installed_components; then
      update_success=false
    fi
  else
    if ! update_all_installed_components; then
      update_success=false
    fi
  fi

  show_final_summary "Update" "$preset" "$update_success"
  if [ "$update_success" = "true" ]; then
    exit 0
  else
    exit 1
  fi
}

cmd_backup() {
  local subcommand="${1:-}"

  case "$subcommand" in
    --verbose | -v)
      export MEOW_VERBOSE="true"
      subcommand="${2:-}"
      shift 2
      ;;
    --dry-run)
      export MEOW_DRY_RUN="true"
      subcommand="${2:-}"
      shift 2
      ;;
    --help | -h)
      show_backup_help
      exit 0
      ;;
    "")
      ui_error "No backup subcommand specified"
      show_backup_help
      exit 1
      ;;
    *)
      shift
      ;;
  esac

  source "${MEOW}/lib/symlinks/symlinks.sh"

  case "$subcommand" in
    list)
      local list_args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --verbose | -v)
            export MEOW_VERBOSE="true"
            shift
            ;;
          --dry-run)
            export MEOW_DRY_RUN="true"
            shift
            ;;
          *)
            list_args+=("$1")
            shift
            ;;
        esac
      done

      if [ ${#list_args[@]} -gt 1 ]; then
        ui_error "Too many arguments for backup list command"
        exit 1
      fi

      local pattern="${list_args[0]:-}"
      list_backups "$pattern"
      ;;
    restore)
      local restore_args=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --verbose | -v)
            export MEOW_VERBOSE="true"
            shift
            ;;
          --dry-run)
            export MEOW_DRY_RUN="true"
            shift
            ;;
          *)
            restore_args+=("$1")
            shift
            ;;
        esac
      done

      if [ ${#restore_args[@]} -eq 0 ]; then
        ui_error "No backup file specified for restore command"
        exit 1
      fi
      if [ ${#restore_args[@]} -gt 1 ]; then
        ui_error "Too many arguments for backup restore command"
        exit 1
      fi

      local backup_file="${restore_args[0]}"
      restore_backup "$backup_file"
      ;;
    *)
      ui_error "Unknown backup subcommand: $subcommand"
      show_backup_help
      exit 1
      ;;
  esac
}

cmd_help() {
  local command="${1:-}"
  case "$command" in
    install)
      show_install_help
      ;;
    component)
      show_component_help
      ;;
    backup)
      show_backup_help
      ;;
    config)
      show_config_help
      ;;
    theme)
      show_theme_help
      ;;
    *)
      show_main_help
      ;;
  esac
}

cmd_config() {
  local subcommand="${1:-}"
  
  # Check if config library exists
  if [ ! -f "${MEOW}/lib/config/config.sh" ]; then
    ui_error "Config library not found. Please ensure shell-essential component is installed."
    exit 1
  fi
  
  # Source config library if not already sourced
  if ! type meow_config_get >/dev/null 2>&1; then
    source "${MEOW}/lib/config/config.sh"
  fi
  
  case "$subcommand" in
    show|list|"")
      meow_config_show
      ;;
    get)
      if [ -z "${2:-}" ]; then
        ui_error "Usage: meowctl config get <key>"
        exit 1
      fi
      meow_config_get "$2"
      ;;
    set)
      if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
        ui_error "Usage: meowctl config set <key> <value>"
        exit 1
      fi
      meow_config_set "$2" "$3"
      ;;
    unset|delete|remove)
      if [ -z "${2:-}" ]; then
        ui_error "Usage: meowctl config unset <key>"
        exit 1
      fi
      meow_config_unset "$2"
      ;;
    edit)
      meow_config_edit
      ;;
    *)
      ui_error "Unknown config subcommand: $subcommand"
      show_config_help
      exit 1
      ;;
  esac
}

cmd_theme() {
  # Check if meow-theme script exists
  local theme_script="${MEOW}/components/shell-essential/scripts/meow-theme"
  
  if [ ! -f "$theme_script" ]; then
    ui_error "Theme script not found. Please ensure shell-essential component is installed."
    exit 1
  fi
  
  # Execute meow-theme with all arguments
  exec "$theme_script" "$@"
}

show_config_help() {
  ui_title "meowctl config"
  ui_message "Manage meow configuration."
  ui_message ""
  ui_message "Usage: $0 config <subcommand> [arguments]"
  ui_message ""
  ui_message "Subcommands:"
  ui_message "  show                Show all configuration"
  ui_message "  list                Alias for show"
  ui_message "  get <key>          Get a configuration value"
  ui_message "  set <key> <value>  Set a configuration value"
  ui_message "  unset <key>        Remove a configuration value"
  ui_message "  edit               Edit configuration interactively"
  ui_message ""
  ui_message "Examples:"
  ui_message "  $0 config show"
  ui_message "  $0 config get theme.preset"
  ui_message "  $0 config set theme.mode night"
  ui_message "  $0 config unset theme.auto_sync"
  ui_message ""
}

show_theme_help() {
  ui_title "meowctl theme"
  ui_message "Manage themes across terminal environment."
  ui_message ""
  ui_message "Usage: $0 theme [command]"
  ui_message ""
  ui_message "Commands:"
  ui_message "  menu          Interactive menu (default)"
  ui_message "  select        Select theme preset"
  ui_message "  toggle        Toggle day/night mode"
  ui_message "  current       Show current theme"
  ui_message "  apply <preset> <mode>  Apply specific preset"
  ui_message ""
  ui_message "Examples:"
  ui_message "  $0 theme                    # Interactive menu"
  ui_message "  $0 theme select             # Choose preset"
  ui_message "  $0 theme toggle             # Toggle day/night"
  ui_message "  $0 theme apply catppuccin night"
  ui_message ""
}

main() {
  warn_bash_compatibility 0

  # Handle global options and shift them away
  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose | -v)
        export MEOW_VERBOSE="true"
        shift
        ;;
      --dry-run)
        export MEOW_DRY_RUN="true"
        ui_warning "DRY-RUN MODE: No actual changes will be made"
        shift
        ;;
      --help | -h)
        show_main_help
        exit 0
        ;;
      --*)
        ui_error "Unknown global option: $1"
        exit 1
        ;;
      *)
        # Stop parsing global options and break the loop
        break
        ;;
    esac
  done

  local command="${1:-}"

  if [ -z "$command" ]; then
    show_main_help
    exit 0
  fi

  shift # Shift the command itself

  case "$command" in
    install)
      cmd_install "$@"
      ;;
    uninstall)
      cmd_uninstall "$@"
      ;;
    component)
      cmd_component "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    update)
      cmd_update "$@"
      ;;
    backup)
      cmd_backup "$@"
      ;;
    config)
      cmd_config "$@"
      ;;
    theme)
      cmd_theme "$@"
      ;;
    help)
      cmd_help "$@"
      ;;
    *)
      ui_error "Unknown command: $command"
      show_main_help
      exit 1
      ;;
  esac
}

main "$@"
