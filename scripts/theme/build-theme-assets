write_starship_theme() {
  local preset="$1"
  local variant="$2"

  if [[ ! -f "$STARSHIP_CONFIG" ]]; then
    return
  fi

  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local palette_name="meow_${preset_slug}_${variant_slug}"
  local out_file="$STARSHIP_OUT/${preset_slug}-${variant_slug}.toml"

  local temp_file
  temp_file=$(mktemp)

  awk -v palette="$palette_name" '
      BEGIN { skip=0 }
      /^\[palettes\.meow_/ { skip=1; next }
      skip && /^\[/ { skip=0 }
      skip { next }
      /^palette = / { print "palette = '\''" palette "'\''"; next }
      { if (!skip) print }
  ' "$STARSHIP_CONFIG" > "$temp_file"

  local ok
  local danger
  local caution
  local git
  local dir
  local env
  local fg
  local os
  local kube
  local docker
  local shell
  local container
  local other
  local time
  local duration
  local vim_ok
  local vim_replace
  local vim_visual
  ok=$(theme_get_palette_color "$preset" "$variant" "green" || theme_get_palette_color "$preset" "$variant" "leaf" || theme_get_terminal_color "$preset" "$variant" "2" || theme_get_terminal_named_color "$preset" "$variant" "green" || true)
  danger=$(theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || theme_get_terminal_color "$preset" "$variant" "1" || theme_get_terminal_named_color "$preset" "$variant" "red" || true)
  caution=$(theme_get_palette_color "$preset" "$variant" "yellow" || theme_get_palette_color "$preset" "$variant" "wood" || theme_get_terminal_color "$preset" "$variant" "3" || theme_get_terminal_named_color "$preset" "$variant" "yellow" || true)
  git=$(theme_get_palette_color "$preset" "$variant" "cyan" || theme_get_palette_color "$preset" "$variant" "water" || theme_get_terminal_color "$preset" "$variant" "6" || theme_get_terminal_named_color "$preset" "$variant" "cyan" || true)
  dir=$(theme_get_palette_color "$preset" "$variant" "blue" || theme_get_palette_color "$preset" "$variant" "blue1" || theme_get_palette_color "$preset" "$variant" "blue0" || theme_get_terminal_color "$preset" "$variant" "4" || theme_get_terminal_named_color "$preset" "$variant" "blue" || true)
  env=$(theme_get_palette_color "$preset" "$variant" "purple" || theme_get_palette_color "$preset" "$variant" "blossom" || theme_get_terminal_color "$preset" "$variant" "5" || theme_get_terminal_named_color "$preset" "$variant" "magenta" || true)
  fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  os="$danger"
  kube="$env"
  docker="$dir"
  shell="$fg"
  container="$danger"
  other="$fg"
  time="$fg"
  duration="$fg"
  vim_ok="$ok"
  vim_replace="$env"
  vim_visual="$caution"

  {
    echo ""
    echo "[palettes.${palette_name}]"
    [[ -n "$ok" ]] && echo "color_ok = '${ok}'"
    [[ -n "$danger" ]] && echo "color_danger = '${danger}'"
    [[ -n "$caution" ]] && echo "color_caution = '${caution}'"
    [[ -n "$git" ]] && echo "color_git = '${git}'"
    [[ -n "$dir" ]] && echo "color_directory = '${dir}'"
    [[ -n "$env" ]] && echo "color_env = '${env}'"
    [[ -n "$os" ]] && echo "color_os = '${os}'"
    [[ -n "$os" ]] && echo "color_username = '${os}'"
    [[ -n "$git" ]] && echo "color_git_added = '${ok}'"
    [[ -n "$git" ]] && echo "color_git_deleted = '${danger}'"
    [[ -n "$kube" ]] && echo "color_kubernetes = '${kube}'"
    [[ -n "$docker" ]] && echo "color_docker = '${docker}'"
    [[ -n "$shell" ]] && echo "color_shell = '${shell}'"
    [[ -n "$container" ]] && echo "color_container = '${container}'"
    [[ -n "$other" ]] && echo "color_other = '${other}'"
    [[ -n "$time" ]] && echo "color_time = '${time}'"
    [[ -n "$duration" ]] && echo "color_duration = '${duration}'"
    [[ -n "$vim_ok" ]] && echo "color_vimcmd_ok = '${vim_ok}'"
    [[ -n "$vim_replace" ]] && echo "color_vimcmd_replace = '${vim_replace}'"
    [[ -n "$vim_visual" ]] && echo "color_vimcmd_visual = '${vim_visual}'"
  } >> "$temp_file"

  mv "$temp_file" "$out_file"
}

main() {
  if ! command -v yq >/dev/null 2>&1; then
    echo "yq is required to regenerate theme assets." >&2
    exit 1
  fi

  local requested_preset=""
  local requested_variant=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --preset)
        requested_preset="$2"
        shift 2
        ;;
      --variant)
        requested_variant="$2"
        shift 2
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  local preset
  while IFS= read -r preset; do
    if [[ -n "$requested_preset" && "$preset" != "$requested_preset" ]]; then
      continue
    fi
    local variant
    while IFS= read -r variant; do
      if [[ -n "$requested_variant" && "$variant" != "$requested_variant" ]]; then
        continue
      fi
      write_ghostty_theme "$preset" "$variant"
      write_tmux_theme "$preset" "$variant"
      write_starship_theme "$preset" "$variant"
      write_bat_theme "$preset" "$variant"
      write_lazygit_theme "$preset" "$variant"
      write_delta_theme "$preset" "$variant"
      write_fzf_theme "$preset" "$variant"
      write_glow_theme "$preset" "$variant"
      write_eza_theme "$preset" "$variant"
      write_zsh_theme "$preset" "$variant"
    done <<< "$(get_variant_list "$preset")"
  done < <(get_theme_list)
}

main "$@"
