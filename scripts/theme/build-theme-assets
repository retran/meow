write_htop_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$HTOP_OUT/${preset_slug}-${variant_slug}.theme"
  
  # Get colors from theme
  local bg_color
  
  bg_color=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  
  if [[ -z "$bg_color" ]]; then
    return
  fi
  
  # Detect if dark or light theme (simple brightness check)
  local color_scheme="5"  # Default to dark (black night)
  if [[ -n "$bg_color" ]]; then
    if [[ "$bg_color" =~ ^#[a-fA-F] || "$bg_color" =~ ^#[89] ]]; then
      color_scheme="3"  # Light terminal
    fi
  fi
  
  # htop uses predefined color schemes (0-6)
  # 0 = default, 1 = monochrome, 2 = black on white, 3 = light terminal
  # 4 = MC, 5 = black night, 6 = broken gray
  cat > "$out_file" <<EOF
# Generated from themes.yaml
# htop color scheme
# Note: htop has limited theming - uses predefined color schemes
color_scheme=${color_scheme}
# htop has limited theming capabilities
# Only basic color scheme selection is supported
EOF
}

write_zellij_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$ZELLIJ_OUT/${preset_slug}-${variant_slug}.kdl"

  # hex → "R G B"
  local _hex_to_rgb
  _hex_to_rgb() {
    local hex="${1#\#}"
    [[ ${#hex} -ne 6 ]] && echo "0 0 0" && return
    printf "%d %d %d\n" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
  }

  # Return first non-empty value from a list of palette keys
  local _get
  _get() {
    local result=""
    for key in "$@"; do
      result=$(theme_get_palette_color "$preset" "$variant" "$key" 2>/dev/null || true)
      if [[ -n "$result" && "$result" != "null" ]]; then echo "$result"; return; fi
    done
    echo ""
  }

  local bg fg bg_dim bg_sel green red orange cyan purple blue fg_muted
  bg=$(_get       "bg"           "base"         "bg1")
  fg=$(_get       "fg"           "text"         "fg1")
  bg_dim=$(_get   "bg_highlight" "bg_visual"    "bg_dark"    "bg1"  "surface0" "surface1")
  bg_sel=$(_get   "bg_visual"    "bg_search"    "bg_highlight" "surface1" "surface2")
  green=$(_get    "green"        "leaf"         "green1"     "teal")
  red=$(_get      "red"          "rose"         "love"       "error")
  orange=$(_get   "orange"       "peach"        "yellow"     "wood" "highlight")
  cyan=$(_get     "cyan"         "water"        "teal"       "sky"  "blue1")
  purple=$(_get   "purple"       "mauve"        "blossom"    "iris" "magenta")
  blue=$(_get     "blue"         "water"        "sapphire"   "sky"  "blue0")
  fg_muted=$(_get "comment"      "gray"         "dark5"      "fg_gutter" "fg1")

  [[ -z "$bg"       || -z "$fg" ]] && return
  [[ -z "$fg_muted" ]] && fg_muted="$fg"
  [[ -z "$bg_dim"   ]] && bg_dim="$bg"
  [[ -z "$bg_sel"   ]] && bg_sel="$bg_dim"
  [[ -z "$orange"   ]] && orange="$fg"
  [[ -z "$cyan"     ]] && cyan="$fg"
  [[ -z "$purple"   ]] && purple="$fg"
  [[ -z "$blue"     ]] && blue="$fg"
  [[ -z "$green"    ]] && green="$fg"
  [[ -z "$red"      ]] && red="$fg"

  local bg_rgb fg_rgb bg_dim_rgb bg_sel_rgb green_rgb red_rgb orange_rgb cyan_rgb purple_rgb blue_rgb fg_muted_rgb
  bg_rgb=$(_hex_to_rgb "$bg")
  fg_rgb=$(_hex_to_rgb "$fg")
  bg_dim_rgb=$(_hex_to_rgb "$bg_dim")
  bg_sel_rgb=$(_hex_to_rgb "$bg_sel")
  green_rgb=$(_hex_to_rgb "$green")
  red_rgb=$(_hex_to_rgb "$red")
  orange_rgb=$(_hex_to_rgb "$orange")
  cyan_rgb=$(_hex_to_rgb "$cyan")
  purple_rgb=$(_hex_to_rgb "$purple")
  blue_rgb=$(_hex_to_rgb "$blue")
  fg_muted_rgb=$(_hex_to_rgb "$fg_muted")

  cat > "$out_file" <<EOF
// Generated from themes.yaml — ${preset}/${variant}
themes {
    meow {
        text_unselected {
            base       $fg_rgb
            background $bg_dim_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        text_selected {
            base       $fg_rgb
            background $bg_sel_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        ribbon_selected {
            base       $bg_rgb
            background $green_rgb
            emphasis_0 $red_rgb
            emphasis_1 $orange_rgb
            emphasis_2 $purple_rgb
            emphasis_3 $blue_rgb
        }
        ribbon_unselected {
            base       $bg_rgb
            background $fg_muted_rgb
            emphasis_0 $red_rgb
            emphasis_1 $fg_rgb
            emphasis_2 $blue_rgb
            emphasis_3 $purple_rgb
        }
        table_title {
            base       $green_rgb
            background 0
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        table_cell_selected {
            base       $fg_rgb
            background $bg_sel_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        table_cell_unselected {
            base       $fg_rgb
            background $bg_dim_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        list_selected {
            base       $fg_rgb
            background $bg_sel_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        list_unselected {
            base       $fg_rgb
            background $bg_dim_rgb
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $green_rgb
            emphasis_3 $purple_rgb
        }
        frame_selected {
            base       $green_rgb
            background 0
            emphasis_0 $orange_rgb
            emphasis_1 $cyan_rgb
            emphasis_2 $purple_rgb
            emphasis_3 0
        }
        frame_highlight {
            base       $orange_rgb
            background 0
            emphasis_0 $purple_rgb
            emphasis_1 0
            emphasis_2 $orange_rgb
            emphasis_3 $orange_rgb
        }
        exit_code_success {
            base       $green_rgb
            background 0
            emphasis_0 $cyan_rgb
            emphasis_1 $bg_rgb
            emphasis_2 $purple_rgb
            emphasis_3 $blue_rgb
        }
        exit_code_error {
            base       $red_rgb
            background 0
            emphasis_0 $orange_rgb
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1  $purple_rgb
            player_2  $blue_rgb
            player_3  0
            player_4  $orange_rgb
            player_5  $cyan_rgb
            player_6  0
            player_7  $red_rgb
            player_8  0
            player_9  0
            player_10 0
        }
    }
}
EOF
}

main() {
  if ! command -v yq >/dev/null 2>&1; then
    echo "yq is required to regenerate theme assets." >&2
    exit 1
  fi

  local requested_preset=""
  local requested_variant=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --preset)
        requested_preset="$2"
        shift 2
        ;;
      --variant)
        requested_variant="$2"
        shift 2
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  local preset
  while IFS= read -r preset; do
    if [[ -n "$requested_preset" && "$preset" != "$requested_preset" ]]; then
      continue
    fi
    local variant
    while IFS= read -r variant; do
      if [[ -n "$requested_variant" && "$variant" != "$requested_variant" ]]; then
        continue
      fi
      write_ghostty_theme "$preset" "$variant"
      write_zellij_theme "$preset" "$variant"
      write_starship_theme "$preset" "$variant"
      write_bat_theme "$preset" "$variant"
      write_lazygit_theme "$preset" "$variant"
      write_delta_theme "$preset" "$variant"
      write_fzf_theme "$preset" "$variant"
      write_glow_theme "$preset" "$variant"
      write_eza_theme "$preset" "$variant"
      write_zsh_theme "$preset" "$variant"
      write_ripgrep_theme "$preset" "$variant"
      write_tealdeer_theme "$preset" "$variant"
      write_htop_theme "$preset" "$variant"
    done <<< "$(get_variant_list "$preset")"
  done < <(get_theme_list)
}

main "$@"
