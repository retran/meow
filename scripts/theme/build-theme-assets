mkdir -p "$GHOSTTY_OUT" "$STARSHIP_OUT" "$BAT_OUT" "$LAZYGIT_OUT" "$DELTA_OUT" "$FZF_OUT" "$GLOW_OUT" "$EZA_OUT" "$ZSH_OUT" "$RIPGREP_OUT" "$TEALDEER_OUT" "$HTOP_OUT"

if [[ ! -f "$THEME_DB" ]]; then
  echo "Missing theme database at $THEME_DB" >&2
  exit 1
fi

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Missing theme library at $THEME_LIB" >&2
  exit 1
fi

source "$THEME_LIB"

slugify() {
  local value="$1"
  value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
  value=$(echo "$value" | sed 's/[^a-z0-9]/_/g; s/_\+/_/g; s/^_//; s/_$//')
  echo "$value"
}

hex_to_rgb() {
  local hex="$1"
  hex="${hex#\#}"
  hex=$(echo "$hex" | tr '[:lower:]' '[:upper:]')
  
  # Validate hex length
  if [[ ${#hex} -ne 6 ]]; then
    return 1
  fi
  
  local r g b
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  echo "${r},${g},${b}"
}

# blend_hex_colors <color1_hex> <color2_hex> <pct1>
# Returns a hex color that is pct1% of color1 mixed with (100-pct1)% of color2
blend_hex_colors() {
  local c1="$1" c2="$2" pct="${3:-50}"
  c1="${c1#\#}"
  c2="${c2#\#}"
  local r1 g1 b1 r2 g2 b2
  r1=$((16#${c1:0:2})); g1=$((16#${c1:2:2})); b1=$((16#${c1:4:2}))
  r2=$((16#${c2:0:2})); g2=$((16#${c2:2:2})); b2=$((16#${c2:4:2}))
  local r g b
  r=$(( (r1 * pct + r2 * (100 - pct)) / 100 ))
  g=$(( (g1 * pct + g2 * (100 - pct)) / 100 ))
  b=$(( (b1 * pct + b2 * (100 - pct)) / 100 ))
  printf "#%02x%02x%02x\n" "$r" "$g" "$b"
}

get_theme_list() {
  read_yaml_value "$THEME_DB" ".themes | keys | .[]" | sed '/^\s*$/d'
}

get_variant_list() {
  local preset="$1"
  read_yaml_value "$THEME_DB" ".themes.${preset}.variants | keys | .[]" | sed '/^\s*$/d'
}

write_ghostty_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$GHOSTTY_OUT/${preset_slug}-${variant_slug}.conf"

  local colors=()
  local has_terminal=1
  local idx
  if [[ -n "$(theme_get_terminal_color "$preset" "$variant" "0" 2>/dev/null)" ]]; then
    for idx in {0..15}; do
      local color
      color=$(theme_get_terminal_color "$preset" "$variant" "$idx") || color=""
      colors+=("$color")
    done
  else
    local order=(black red green yellow blue magenta cyan white black_bright red_bright green_bright yellow_bright blue_bright magenta_bright cyan_bright white_bright)
    local name
    for name in "${order[@]}"; do
      local color
      color=$(theme_get_terminal_named_color "$preset" "$variant" "$name") || color=""
      colors+=("$color")
    done
    if [[ -z "${colors[0]}" ]]; then
      has_terminal=0
    fi
  fi

  if [[ $has_terminal -eq 0 ]]; then
    local base
    local text
    local red
    local green
    local yellow
    local blue
    local magenta
    local cyan
    local overlay
    base=$(theme_get_palette_color "$preset" "$variant" "bg" || true)
    text=$(theme_get_palette_color "$preset" "$variant" "fg" || true)
    red=$(theme_get_palette_color "$preset" "$variant" "red" || true)
    green=$(theme_get_palette_color "$preset" "$variant" "green" || true)
    yellow=$(theme_get_palette_color "$preset" "$variant" "yellow" || true)
    blue=$(theme_get_palette_color "$preset" "$variant" "blue" || true)
    magenta=$(theme_get_palette_color "$preset" "$variant" "purple" || true)
    cyan=$(theme_get_palette_color "$preset" "$variant" "cyan" || true)
    overlay=$(theme_get_palette_color "$preset" "$variant" "surface0" || theme_get_palette_color "$preset" "$variant" "surface1" || true)

    colors=(
      "$base"
      "$red"
      "$green"
      "$yellow"
      "$blue"
      "$magenta"
      "$cyan"
      "$text"
      "$overlay"
      "$red"
      "$green"
      "$yellow"
      "$blue"
      "$magenta"
      "$cyan"
      "$text"
    )
  fi

  if [[ -z "${colors[0]}" ]]; then
    return
  fi

  local background
  local foreground
  background=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  foreground=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)

  # Strip leading '#' from hex colors (ghostty format: no '#', no quotes)
  local bg_raw="${background#\#}"
  local fg_raw="${foreground#\#}"

  # Look up additional semantic colors from palette
  local selection_bg_raw
  local selection_fg_raw
  local cursor_text_raw
  local split_div_raw
  # Try theme-specific selection_bg key first, then fall back to surface0
  local sel_bg
  sel_bg=$(theme_get_palette_color "$preset" "$variant" "selection_bg" || theme_get_palette_color "$preset" "$variant" "surface0" || true)
  selection_bg_raw="${sel_bg#\#}"
  selection_fg_raw="$fg_raw"
  # cursor-text: use base for light themes, crust for dark themes
  local cursor_text_color
  cursor_text_color=$(theme_get_palette_color "$preset" "$variant" "base" || theme_get_palette_color "$preset" "$variant" "bg" || true)
  cursor_text_raw="${cursor_text_color#\#}"
  # split divider: surface0
  local split_div
  split_div=$(theme_get_palette_color "$preset" "$variant" "surface0" || true)
  split_div_raw="${split_div#\#}"

  {
    echo "# Generated from themes.yaml — ${preset}/${variant}"
    if [[ -n "$bg_raw" ]]; then
      echo "background = ${bg_raw}"
    fi
    if [[ -n "$fg_raw" ]]; then
      echo "foreground = ${fg_raw}"
    fi
    local cursor
    cursor=$(theme_get_palette_color "$preset" "$variant" "cursor_color" || theme_get_palette_color "$preset" "$variant" "rosewater" || theme_get_palette_color "$preset" "$variant" "highlight" || theme_get_palette_color "$preset" "$variant" "accent" || theme_get_palette_color "$preset" "$variant" "orange" || true)
    local cursor_raw="${cursor#\#}"
    if [[ -n "$cursor_raw" ]]; then
      echo "cursor-color = ${cursor_raw}"
    fi
    if [[ -n "$cursor_text_raw" ]]; then
      echo "cursor-text = ${cursor_text_raw}"
    fi
    if [[ -n "$selection_bg_raw" ]]; then
      echo "selection-background = ${selection_bg_raw}"
    fi
    if [[ -n "$fg_raw" ]]; then
      echo "selection-foreground = ${fg_raw}"
    fi
    if [[ -n "$split_div_raw" ]]; then
      echo "split-divider-color = ${split_div_raw}"
    fi
    echo ""
    for idx in {0..15}; do
      echo "palette = $idx=${colors[$idx]}"
    done
  } > "$out_file"
}

map_bat_theme() {
  local preset="$1"
  local variant="$2"
  
  # Map known presets/variants to bat theme names
  case "$preset" in
    catppuccin)
      case "$variant" in
        latte) echo "Catppuccin Latte" ;;
        frappe) echo "Catppuccin Frappe" ;;
        macchiato) echo "Catppuccin Macchiato" ;;
        mocha) echo "Catppuccin Mocha" ;;
        *) echo "Catppuccin Mocha" ;;
      esac
      ;;
    tokyonight)
      case "$variant" in
        day) echo "GitHub" ;;
        storm|night|moon) echo "Nord" ;;
        *) echo "Nord" ;;
      esac
      ;;
    onedark)
      case "$variant" in
        onelight) echo "OneHalfLight" ;;
        *) echo "OneHalfDark" ;;
      esac
      ;;
    dracula)
      echo "Dracula"
      ;;
    nord)
      echo "Nord"
      ;;
    material)
      case "$variant" in
        lighter) echo "GitHub" ;;
        *) echo "Monokai Extended" ;;
      esac
      ;;
    github)
      echo "GitHub"
      ;;
    gruvbox)
      echo "Monokai Extended"
      ;;
    ayu)
      case "$variant" in
        light) echo "Solarized (light)" ;;
        *) echo "Solarized (dark)" ;;
      esac
      ;;
    *)
      # Default fallback based on background color brightness
      local bg
      bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
      if [[ -n "$bg" ]]; then
        # Simple brightness check: if bg starts with #[a-f][0-9], assume light
        if [[ "$bg" =~ ^#[a-fA-F] || "$bg" =~ ^#[89] ]]; then
          echo "GitHub"
        else
          echo "OneHalfDark"
        fi
      else
        echo "OneHalfDark"
      fi
      ;;
  esac
}

write_bat_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$BAT_OUT/${preset_slug}-${variant_slug}.conf"
  
  local bat_theme
  bat_theme=$(map_bat_theme "$preset" "$variant")
  
  echo "--theme=\"${bat_theme}\"" > "$out_file"
}

write_lazygit_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$LAZYGIT_OUT/${preset_slug}-${variant_slug}.yml"
  
  # Get colors from theme
  local fg
  local bg
  local inactive_border
  local selected_line_bg
  local cherry_pick_bg
  local cherry_pick_fg
  local unstaged
  local searching_border
  local default_fg
  local accent
  
  fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  # inactive border: lazygit_inactive_border override, then subtext0/comment/overlay0
  inactive_border=$(theme_get_palette_color "$preset" "$variant" "lazygit_inactive_border" || theme_get_palette_color "$preset" "$variant" "subtext0" || theme_get_palette_color "$preset" "$variant" "comment" || theme_get_palette_color "$preset" "$variant" "overlay0" || true)
  # selected line bg: lazygit_selected_line_bg override, then surface0/bg_highlight/selection_bg
  selected_line_bg=$(theme_get_palette_color "$preset" "$variant" "lazygit_selected_line_bg" || theme_get_palette_color "$preset" "$variant" "surface0" || theme_get_palette_color "$preset" "$variant" "bg_highlight" || theme_get_palette_color "$preset" "$variant" "selection_bg" || true)
  # cherry pick bg: lazygit_cherry_pick_bg override, then surface1/surface0
  cherry_pick_bg=$(theme_get_palette_color "$preset" "$variant" "lazygit_cherry_pick_bg" || theme_get_palette_color "$preset" "$variant" "surface1" || theme_get_palette_color "$preset" "$variant" "surface0" || true)
  # active/accent: lazygit_active_border override, then blue/water/pink
  accent=$(theme_get_palette_color "$preset" "$variant" "lazygit_active_border" || theme_get_palette_color "$preset" "$variant" "blue" || theme_get_palette_color "$preset" "$variant" "water" || theme_get_palette_color "$preset" "$variant" "pink" || true)
  # cherry pick fg: lazygit_cherry_pick_fg override, then accent
  cherry_pick_fg=$(theme_get_palette_color "$preset" "$variant" "lazygit_cherry_pick_fg" || echo "$accent")
  # options text: lazygit_options_text override, then accent
  local options_text
  options_text=$(theme_get_palette_color "$preset" "$variant" "lazygit_options_text" || echo "$accent")
  # unstaged changes: lazygit_unstaged override, then red/rose
  unstaged=$(theme_get_palette_color "$preset" "$variant" "lazygit_unstaged" || theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || theme_get_terminal_color "$preset" "$variant" "1" || true)
  # searching border: lazygit_searching_border override, then yellow/wood/cyan
  searching_border=$(theme_get_palette_color "$preset" "$variant" "lazygit_searching_border" || theme_get_palette_color "$preset" "$variant" "yellow" || theme_get_palette_color "$preset" "$variant" "wood" || theme_get_palette_color "$preset" "$variant" "cyan" || true)
  default_fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "text" || true)
  
  if [[ -z "$fg" ]] || [[ -z "$bg" ]]; then
    return
  fi
  
  # Write lazygit config
  {
    echo "# Generated from themes.yaml — ${preset}/${variant}"
    echo "gui:"
    echo "  theme:"
    echo "    activeBorderColor:"
    echo "      - \"${accent}\""
    echo "      - bold"
    echo "    inactiveBorderColor:"
    echo "      - \"${inactive_border:-$fg}\""
    echo "    optionsTextColor:"
    echo "      - \"${options_text}\""
    echo "    selectedLineBgColor:"
    echo "      - \"${selected_line_bg}\""
    echo "    cherryPickedCommitBgColor:"
    echo "      - \"${cherry_pick_bg}\""
    echo "    cherryPickedCommitFgColor:"
    echo "      - \"${cherry_pick_fg}\""
    echo "    unstagedChangesColor:"
    echo "      - \"${unstaged}\""
    echo "    defaultFgColor:"
    echo "      - \"${default_fg}\""
    if [[ -n "$searching_border" ]]; then
      echo "    searchingActiveBorderColor:"
      echo "      - \"${searching_border}\""
      echo "      - bold"
    fi
  } > "$out_file"
}

write_delta_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$DELTA_OUT/${preset_slug}-${variant_slug}.conf"
  
  local delta_theme
  delta_theme=$(map_bat_theme "$preset" "$variant")
  
  # Get palette colors
  local bg fg red green base overlay0 surface0 surface1 surface2 subtext1 yellow blue mauve cyan purple
  local delta_minus_bg delta_minus_emph_bg delta_plus_bg delta_plus_emph_bg
  local delta_minus_line_num delta_plus_line_num delta_zero_line_num
  bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  base=$(theme_get_palette_color "$preset" "$variant" "base" || theme_get_palette_color "$preset" "$variant" "bg" || true)
  red=$(theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || true)
  green=$(theme_get_palette_color "$preset" "$variant" "green" || theme_get_palette_color "$preset" "$variant" "leaf" || true)
  overlay0=$(theme_get_palette_color "$preset" "$variant" "overlay0" || theme_get_palette_color "$preset" "$variant" "comment" || true)
  surface0=$(theme_get_palette_color "$preset" "$variant" "surface0" || true)
  surface1=$(theme_get_palette_color "$preset" "$variant" "surface1" || true)
  surface2=$(theme_get_palette_color "$preset" "$variant" "surface2" || true)
  subtext1=$(theme_get_palette_color "$preset" "$variant" "subtext1" || theme_get_palette_color "$preset" "$variant" "fg" || true)
  yellow=$(theme_get_palette_color "$preset" "$variant" "yellow" || theme_get_palette_color "$preset" "$variant" "wood" || true)
  blue=$(theme_get_palette_color "$preset" "$variant" "blue" || theme_get_palette_color "$preset" "$variant" "water" || true)
  mauve=$(theme_get_palette_color "$preset" "$variant" "mauve" || theme_get_palette_color "$preset" "$variant" "purple" || true)
  cyan=$(theme_get_palette_color "$preset" "$variant" "sky" || theme_get_palette_color "$preset" "$variant" "teal" || true)
  purple=$(theme_get_palette_color "$preset" "$variant" "mauve" || theme_get_palette_color "$preset" "$variant" "purple" || true)
  # Delta override keys (if set, skip blending and use exact upstream colors)
  delta_minus_bg=$(theme_get_palette_color "$preset" "$variant" "delta_minus_bg" || true)
  delta_minus_emph_bg=$(theme_get_palette_color "$preset" "$variant" "delta_minus_emph_bg" || true)
  delta_plus_bg=$(theme_get_palette_color "$preset" "$variant" "delta_plus_bg" || true)
  delta_plus_emph_bg=$(theme_get_palette_color "$preset" "$variant" "delta_plus_emph_bg" || true)
  delta_minus_line_num=$(theme_get_palette_color "$preset" "$variant" "delta_minus_line_num" || true)
  delta_plus_line_num=$(theme_get_palette_color "$preset" "$variant" "delta_plus_line_num" || true)
  delta_zero_line_num=$(theme_get_palette_color "$preset" "$variant" "delta_zero_line_num" || true)
  
  if [[ -z "$bg" ]] || ([[ -z "$red" ]] && [[ -z "$delta_minus_bg" ]]) || ([[ -z "$green" ]] && [[ -z "$delta_plus_bg" ]]); then
    # Fallback: just write syntax-theme
    cat > "$out_file" <<EOF
# Generated from themes.yaml — ${preset}/${variant}
[delta]
	navigate = true
	syntax-theme = ${delta_theme}
EOF
    return
  fi

  # Determine light/dark
  local light_flag="false"
  if [[ -n "$base" ]]; then
    # Simple brightness heuristic: if first hex nibble of base is high (a-f or 8-9), it's light
    local base_clean="${base#\#}"
    local first_char="${base_clean:0:1}"
    if [[ "$first_char" =~ [a-fA-F89] ]]; then
      light_flag="true"
    fi
  fi

  # Compute blended minus/plus colors (matching catppuccin/delta approach)
  # minus-style:      20% red + 80% base
  # minus-emph-style: 35% red + 65% base
  # plus-style:       20% green + 80% base
  # plus-emph-style:  35% green + 65% base
  # If delta_minus_bg / delta_plus_bg overrides are set, use them directly instead of blending
  local base_color="${base:-$bg}"
  local minus_style="" minus_emph="" plus_style="" plus_emph=""
  if [[ -n "$delta_minus_bg" ]]; then
    minus_style="$delta_minus_bg"
    minus_emph="${delta_minus_emph_bg:-$delta_minus_bg}"
  elif [[ -n "$red" ]] && [[ -n "$base_color" ]]; then
    minus_style=$(blend_hex_colors "$red" "$base_color" 20)
    minus_emph=$(blend_hex_colors "$red" "$base_color" 35)
  fi
  if [[ -n "$delta_plus_bg" ]]; then
    plus_style="$delta_plus_bg"
    plus_emph="${delta_plus_emph_bg:-$delta_plus_bg}"
  elif [[ -n "$green" ]] && [[ -n "$base_color" ]]; then
    plus_style=$(blend_hex_colors "$green" "$base_color" 20)
    plus_emph=$(blend_hex_colors "$green" "$base_color" 35)
  fi

  # Blame palette: use surface colors from dark→light (or light→dark for light themes)
  local blame_palette=""
  if [[ "$light_flag" == "true" ]]; then
    blame_palette="${base_color} ${surface0:-$base_color} ${surface1:-$base_color} ${surface2:-$base_color} ${subtext1:-$fg}"
  else
    blame_palette="${base_color} ${surface0:-$base_color} ${surface1:-$base_color} ${surface2:-$base_color} ${overlay0:-$fg}"
  fi

  local file_dec_color="${overlay0:-$fg}"
  local hunk_line_num_color="${subtext1:-$fg}"

  {
    echo "# Generated from themes.yaml — ${preset}/${variant}"
    echo "[delta]"
    echo "	navigate = true"
    echo "	light = ${light_flag}"
    echo "	syntax-theme = ${delta_theme}"
    echo ""
    echo "	# File and hunk headers"
    echo "	file-style = \"${fg}\""
    echo "	file-decoration-style = \"${file_dec_color}\""
    echo "	hunk-header-style = file line-number syntax"
    echo "	hunk-header-file-style = bold"
    echo "	hunk-header-line-number-style = bold \"${hunk_line_num_color}\""
    echo "	hunk-header-decoration-style = \"${file_dec_color}\" box ul"
    echo ""
    echo "	# Line numbers"
    echo "	line-numbers = true"
    echo "	line-numbers-left-style = \"${file_dec_color}\""
    echo "	line-numbers-right-style = \"${file_dec_color}\""
    echo "	line-numbers-minus-style = bold \"${delta_minus_line_num:-$red}\""
    echo "	line-numbers-plus-style = bold \"${delta_plus_line_num:-$green}\""
    echo "	line-numbers-zero-style = \"${delta_zero_line_num:-$file_dec_color}\""
    echo ""
    echo "	# Diff content"
    if [[ -n "$minus_style" ]]; then
      echo "	minus-style = syntax \"${minus_style}\""
    fi
    if [[ -n "$minus_emph" ]]; then
      echo "	minus-emph-style = bold syntax \"${minus_emph}\""
    fi
    if [[ -n "$plus_style" ]]; then
      echo "	plus-style = syntax \"${plus_style}\""
    fi
    if [[ -n "$plus_emph" ]]; then
      echo "	plus-emph-style = bold syntax \"${plus_emph}\""
    fi
    echo ""
    echo "	# Commit/blame"
    if [[ -n "$mauve" ]]; then
      echo "	commit-decoration-style = \"${mauve}\" bold box ul"
    fi
    if [[ -n "$blame_palette" ]]; then
      echo "	blame-palette = \"${blame_palette}\""
    fi
  } > "$out_file"
}

write_fzf_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$FZF_OUT/${preset_slug}-${variant_slug}.sh"
  
  # Get colors from theme
  local bg
  local fg
  local hl
  local fg_plus
  local bg_plus
  local hl_plus
  local info
  local prompt
  local pointer
  local marker
  local spinner
  local header
  
  bg=$(theme_get_palette_color "$preset" "$variant" "fzf_bg" || theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  fg=$(theme_get_palette_color "$preset" "$variant" "fzf_fg" || theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  # fzf_hl override, then fallback to red/rose
  hl=$(theme_get_palette_color "$preset" "$variant" "fzf_hl" || theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || true)
  fg_plus=$(theme_get_palette_color "$preset" "$variant" "fg" || true)
  bg_plus=$(theme_get_palette_color "$preset" "$variant" "fzf_bg_plus" || theme_get_palette_color "$preset" "$variant" "surface0" || theme_get_palette_color "$preset" "$variant" "bg_highlight" || theme_get_palette_color "$preset" "$variant" "selection_bg" || true)
  # fzf_hl_plus override, then fallback to fzf_hl value
  hl_plus=$(theme_get_palette_color "$preset" "$variant" "fzf_hl_plus" || theme_get_palette_color "$preset" "$variant" "fzf_hl" || theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || true)
  # info: fzf_info override, then mauve/purple (catppuccin style)
  info=$(theme_get_palette_color "$preset" "$variant" "fzf_info" || theme_get_palette_color "$preset" "$variant" "mauve" || theme_get_palette_color "$preset" "$variant" "purple" || theme_get_palette_color "$preset" "$variant" "cyan" || true)
  # prompt: fzf_prompt override, then mauve/purple/blue
  prompt=$(theme_get_palette_color "$preset" "$variant" "fzf_prompt" || theme_get_palette_color "$preset" "$variant" "mauve" || theme_get_palette_color "$preset" "$variant" "purple" || theme_get_palette_color "$preset" "$variant" "blue" || true)
  # pointer: fzf_pointer override, then rosewater/accent
  pointer=$(theme_get_palette_color "$preset" "$variant" "fzf_pointer" || theme_get_palette_color "$preset" "$variant" "rosewater" || theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || true)
  # spinner: fzf_spinner override, then rosewater/yellow
  spinner=$(theme_get_palette_color "$preset" "$variant" "fzf_spinner" || theme_get_palette_color "$preset" "$variant" "rosewater" || theme_get_palette_color "$preset" "$variant" "yellow" || true)
  # marker: fzf_marker override, then lavender/purple
  marker=$(theme_get_palette_color "$preset" "$variant" "fzf_marker" || theme_get_palette_color "$preset" "$variant" "lavender" || theme_get_palette_color "$preset" "$variant" "purple" || theme_get_palette_color "$preset" "$variant" "blossom" || true)
  # header: fzf_header override, then red/rose/blue
  header=$(theme_get_palette_color "$preset" "$variant" "fzf_header" || theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || theme_get_palette_color "$preset" "$variant" "blue" || true)
  # selected-bg: fzf_selected_bg override, then surface1
  local selected_bg
  selected_bg=$(theme_get_palette_color "$preset" "$variant" "fzf_selected_bg" || theme_get_palette_color "$preset" "$variant" "surface1" || theme_get_palette_color "$preset" "$variant" "bg_highlight" || true)
  # border: fzf_border override, then overlay0/comment
  local border
  border=$(theme_get_palette_color "$preset" "$variant" "fzf_border" || theme_get_palette_color "$preset" "$variant" "overlay0" || theme_get_palette_color "$preset" "$variant" "comment" || true)
  # label: fzf_label override, then text/fg
  local label
  label=$(theme_get_palette_color "$preset" "$variant" "fzf_label" || theme_get_palette_color "$preset" "$variant" "text" || theme_get_palette_color "$preset" "$variant" "fg" || true)
  
  if [[ -z "$bg" ]] || [[ -z "$fg" ]]; then
    return
  fi
  
  # Keep '#' prefix — fzf expects full hex color codes
  local sel_bg_part=""
  if [[ -n "$selected_bg" ]]; then
    sel_bg_part=" \\\\"$'\n'"--color=selected-bg:${selected_bg}"
  fi
  local border_label_part=""
  if [[ -n "$border" ]] && [[ -n "$label" ]]; then
    border_label_part=" \\\\"$'\n'"--color=border:${border},label:${label}"
  fi

  {
    echo "# Generated from themes.yaml — ${preset}/${variant}"
    printf 'export FZF_DEFAULT_OPTS=" \\\n'
    printf -- '--color=bg+:%s,bg:%s,spinner:%s,hl:%s \\\n' "${bg_plus}" "${bg}" "${spinner}" "${hl}"
    printf -- '--color=fg:%s,header:%s,info:%s,pointer:%s \\\n' "${fg}" "${header}" "${info}" "${pointer}"
    printf -- '--color=marker:%s,fg+:%s,prompt:%s,hl+:%s' "${marker}" "${fg_plus}" "${prompt}" "${hl_plus}"
    if [[ -n "$selected_bg" ]]; then
      printf ' \\\n--color=selected-bg:%s' "${selected_bg}"
    fi
    if [[ -n "$border" ]] && [[ -n "$label" ]]; then
      printf ' \\\n--color=border:%s,label:%s' "${border}" "${label}"
    fi
    printf '"\n'
  } > "$out_file"
}

