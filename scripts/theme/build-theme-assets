    [[ -n "$danger" ]] && echo "color_danger = '${danger}'"
    [[ -n "$caution" ]] && echo "color_caution = '${caution}'"
    [[ -n "$git" ]] && echo "color_git = '${git}'"
    [[ -n "$dir" ]] && echo "color_directory = '${dir}'"
    [[ -n "$env" ]] && echo "color_env = '${env}'"
    [[ -n "$os" ]] && echo "color_os = '${os}'"
