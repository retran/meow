set -euo pipefail

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_DB="$MEOW_ROOT/themes.yaml"
THEME_LIB="$MEOW_ROOT/lib/theme/theme.sh"

GHOSTTY_OUT="$MEOW_ROOT/components/terminal-apps/config/ghostty/themes"
TMUX_OUT="$MEOW_ROOT/components/tmux/config/themes"
STARSHIP_CONFIG="$MEOW_ROOT/components/shell-essential/config/starship/starship.toml"
STARSHIP_OUT="$MEOW_ROOT/components/shell-essential/config/starship/themes"
BAT_OUT="$MEOW_ROOT/components/shell-essential/config/bat/themes"
LAZYGIT_OUT="$MEOW_ROOT/components/dev-tools/config/lazygit/themes"
DELTA_OUT="$MEOW_ROOT/components/shell-essential/config/delta/themes"
FZF_OUT="$MEOW_ROOT/components/shell-essential/config/fzf/themes"
GLOW_OUT="$MEOW_ROOT/components/shell-essential/config/glow/themes"
EZA_OUT="$MEOW_ROOT/components/shell-essential/config/eza/themes"
ZSH_OUT="$MEOW_ROOT/components/shell-essential/config/zsh/themes"

mkdir -p "$GHOSTTY_OUT" "$TMUX_OUT" "$STARSHIP_OUT" "$BAT_OUT" "$LAZYGIT_OUT" "$DELTA_OUT" "$FZF_OUT" "$GLOW_OUT" "$EZA_OUT" "$ZSH_OUT"

if [[ ! -f "$THEME_DB" ]]; then
  echo "Missing theme database at $THEME_DB" >&2
  exit 1
fi

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Missing theme library at $THEME_LIB" >&2
  exit 1
fi

source "$THEME_LIB"

slugify() {
  local value="$1"
  value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
  value=$(echo "$value" | sed 's/[^a-z0-9]/_/g; s/_\+/_/g; s/^_//; s/_$//')
  echo "$value"
}

get_theme_list() {
  read_yaml_value "$THEME_DB" ".themes | keys | .[]" | sed '/^\s*$/d'
}

get_variant_list() {
  local preset="$1"
  read_yaml_value "$THEME_DB" ".themes.${preset}.variants | keys | .[]" | sed '/^\s*$/d'
}

write_ghostty_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$GHOSTTY_OUT/${preset_slug}-${variant_slug}.conf"

  local colors=()
  local has_terminal=1
  local idx
  if [[ -n "$(theme_get_terminal_color "$preset" "$variant" "0" 2>/dev/null)" ]]; then
    for idx in {0..15}; do
      local color
      color=$(theme_get_terminal_color "$preset" "$variant" "$idx") || color=""
      colors+=("$color")
    done
  else
    local order=(black red green yellow blue magenta cyan white black_bright red_bright green_bright yellow_bright blue_bright magenta_bright cyan_bright white_bright)
    local name
    for name in "${order[@]}"; do
      local color
      color=$(theme_get_terminal_named_color "$preset" "$variant" "$name") || color=""
      colors+=("$color")
    done
    if [[ -z "${colors[0]}" ]]; then
      has_terminal=0
    fi
  fi

  if [[ $has_terminal -eq 0 ]]; then
    local base
    local text
    local red
    local green
    local yellow
    local blue
    local magenta
    local cyan
    local overlay
    base=$(theme_get_palette_color "$preset" "$variant" "bg" || true)
    text=$(theme_get_palette_color "$preset" "$variant" "fg" || true)
    red=$(theme_get_palette_color "$preset" "$variant" "red" || true)
    green=$(theme_get_palette_color "$preset" "$variant" "green" || true)
    yellow=$(theme_get_palette_color "$preset" "$variant" "yellow" || true)
    blue=$(theme_get_palette_color "$preset" "$variant" "blue" || true)
    magenta=$(theme_get_palette_color "$preset" "$variant" "purple" || true)
    cyan=$(theme_get_palette_color "$preset" "$variant" "cyan" || true)
    overlay=$(theme_get_palette_color "$preset" "$variant" "surface0" || theme_get_palette_color "$preset" "$variant" "surface1" || true)

    colors=(
      "$base"
      "$red"
      "$green"
      "$yellow"
      "$blue"
      "$magenta"
      "$cyan"
      "$text"
      "$overlay"
      "$red"
      "$green"
      "$yellow"
      "$blue"
      "$magenta"
      "$cyan"
      "$text"
    )
  fi

  if [[ -z "${colors[0]}" ]]; then
    return
  fi

  local background
  local foreground
  background=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  foreground=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)

  {
    echo "# Generated from themes.yaml"
    if [[ -n "$background" ]]; then
      echo "background = \"$background\""
      echo "selection-foreground = \"$background\""
    fi
    if [[ -n "$foreground" ]]; then
      echo "foreground = \"$foreground\""
      echo "selection-background = \"$foreground\""
    fi
    local cursor
    cursor=$(theme_get_palette_color "$preset" "$variant" "highlight" || theme_get_palette_color "$preset" "$variant" "accent" || theme_get_palette_color "$preset" "$variant" "orange" || true)
    if [[ -n "$cursor" ]]; then
      echo "cursor-color = \"$cursor\""
      if [[ -n "$background" ]]; then
        echo "cursor-text = \"$background\""
      fi
    fi
    for idx in {0..15}; do
      echo "palette = $idx=${colors[$idx]}"
    done
  } > "$out_file"
}

write_tmux_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$TMUX_OUT/${preset_slug}-${variant_slug}.conf"

  local bg
  local fg
  local accent
  local border
  local alert
  local ok
  local status_bg
  local status_fg
  local message_bg
  bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  accent=$(theme_get_palette_color "$preset" "$variant" "blue" || theme_get_palette_color "$preset" "$variant" "blue1" || theme_get_palette_color "$preset" "$variant" "blue0" || theme_get_palette_color "$preset" "$variant" "water" || theme_get_terminal_color "$preset" "$variant" "4" || theme_get_terminal_named_color "$preset" "$variant" "blue" || true)
  border=$(theme_get_palette_color "$preset" "$variant" "border" || theme_get_palette_color "$preset" "$variant" "gray" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  alert=$(theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || theme_get_terminal_color "$preset" "$variant" "1" || theme_get_terminal_named_color "$preset" "$variant" "red" || true)
  ok=$(theme_get_palette_color "$preset" "$variant" "green" || theme_get_palette_color "$preset" "$variant" "leaf" || theme_get_terminal_color "$preset" "$variant" "2" || theme_get_terminal_named_color "$preset" "$variant" "green" || true)
  status_bg=$(theme_get_palette_color "$preset" "$variant" "bg_statusline" || theme_get_palette_color "$preset" "$variant" "bg_dark" || theme_get_palette_color "$preset" "$variant" "bg" || true)
  status_fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg_sidebar" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  message_bg=$(theme_get_palette_color "$preset" "$variant" "bg_highlight" || theme_get_palette_color "$preset" "$variant" "bg_visual" || true)

  if [[ -z "$bg" ]] || [[ -z "$fg" ]]; then
    return
  fi

  if [[ -z "$accent" ]]; then
    accent="$fg"
  fi
  if [[ -z "$border" ]]; then
    border="$fg"
  fi
  if [[ -z "$alert" ]]; then
    alert="$fg"
  fi
  if [[ -z "$ok" ]]; then
    ok="$fg"
  fi
  if [[ -z "$status_bg" ]]; then
    status_bg="$bg"
  fi
  if [[ -z "$status_fg" ]]; then
    status_fg="$fg"
  fi
  if [[ -z "$message_bg" ]]; then
    message_bg="$accent"
  fi

  cat > "$out_file" <<EOF
set -g status-style "bg=${status_bg},fg=${status_fg}"
set -g status-left-style NONE
set -g status-right-style NONE
set -g message-style "bg=${message_bg},fg=${status_fg}"
set -g message-command-style "bg=${status_bg},fg=${status_fg}"
set -g pane-border-style "fg=${border}"
set -g pane-active-border-style "fg=${accent}"
set -g window-status-activity-style "fg=${status_fg},bg=${status_bg}"
set -g window-status-style "fg=${status_fg},bg=${status_bg}"
set -g window-status-current-format "#[fg=${status_bg},bg=${accent},bold] #I #[fg=${status_fg},bg=${status_bg}] #W #F "
set -g window-status-format "#[fg=${status_fg},bg=${status_bg}] #I #[fg=${status_fg},bg=${status_bg}] #W #F "
set -g status-left "#[fg=${status_bg},bg=${accent},bold] #S #[fg=${accent},bg=${status_bg}]"
set -g status-right "#[fg=${ok},bg=${status_bg}] %Y-%m-%d #[fg=${accent},bg=${status_bg}]  #[fg=${status_bg},bg=${accent},bold] %H:%M "
set -g mode-style "fg=${ok},bg=${status_bg}"
set -g window-status-bell-style "fg=${alert},bg=${status_bg},bold"
EOF
}

map_bat_theme() {
  local preset="$1"
  local variant="$2"
  
  # Map known presets/variants to bat theme names
  case "$preset" in
    catppuccin)
      case "$variant" in
        latte) echo "Catppuccin Latte" ;;
        frappe) echo "Catppuccin Frappe" ;;
        macchiato) echo "Catppuccin Macchiato" ;;
        mocha) echo "Catppuccin Mocha" ;;
        *) echo "Catppuccin Mocha" ;;
      esac
      ;;
    tokyonight)
      case "$variant" in
        day) echo "GitHub" ;;
        storm|night|moon) echo "Nord" ;;
        *) echo "Nord" ;;
      esac
      ;;
    onedark)
      case "$variant" in
        onelight) echo "OneHalfLight" ;;
        *) echo "OneHalfDark" ;;
      esac
      ;;
    dracula)
      echo "Dracula"
      ;;
    nord)
      echo "Nord"
      ;;
    material)
      case "$variant" in
        lighter) echo "GitHub" ;;
        *) echo "Monokai Extended" ;;
      esac
      ;;
    github)
      echo "GitHub"
      ;;
    gruvbox)
      echo "Monokai Extended"
      ;;
    ayu)
      case "$variant" in
        light) echo "Solarized (light)" ;;
        *) echo "Solarized (dark)" ;;
      esac
      ;;
    *)
      # Default fallback based on background color brightness
      local bg
      bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
      if [[ -n "$bg" ]]; then
        # Simple brightness check: if bg starts with #[a-f][0-9], assume light
        if [[ "$bg" =~ ^#[a-fA-F] || "$bg" =~ ^#[89] ]]; then
          echo "GitHub"
        else
          echo "OneHalfDark"
        fi
      else
        echo "OneHalfDark"
      fi
      ;;
  esac
}

write_bat_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$BAT_OUT/${preset_slug}-${variant_slug}.conf"
  
  local bat_theme
  bat_theme=$(map_bat_theme "$preset" "$variant")
  
  echo "--theme=\"${bat_theme}\"" > "$out_file"
}

write_lazygit_theme() {
  local preset="$1"
  local variant="$2"
  local preset_slug
  local variant_slug
  preset_slug=$(slugify "$preset")
  variant_slug=$(slugify "$variant")
  local out_file="$LAZYGIT_OUT/${preset_slug}-${variant_slug}.yml"
  
  # Get colors from theme
  local fg
  local bg
  local selected_bg
  local selected_fg
  local cherry_pick
  local untracked
  local default_fg
  local default_bg
  
  fg=$(theme_get_palette_color "$preset" "$variant" "fg" || theme_get_palette_color "$preset" "$variant" "fg1" || true)
  bg=$(theme_get_palette_color "$preset" "$variant" "bg" || theme_get_palette_color "$preset" "$variant" "bg1" || true)
  selected_bg=$(theme_get_palette_color "$preset" "$variant" "bg_highlight" || theme_get_palette_color "$preset" "$variant" "bg_visual" || theme_get_palette_color "$preset" "$variant" "selection_bg" || true)
  selected_fg=$(theme_get_palette_color "$preset" "$variant" "fg" || true)
  cherry_pick=$(theme_get_palette_color "$preset" "$variant" "cyan" || theme_get_palette_color "$preset" "$variant" "water" || theme_get_terminal_color "$preset" "$variant" "6" || true)
  untracked=$(theme_get_palette_color "$preset" "$variant" "red" || theme_get_palette_color "$preset" "$variant" "rose" || theme_get_terminal_color "$preset" "$variant" "1" || true)
  default_fg=$(theme_get_palette_color "$preset" "$variant" "blue" || theme_get_palette_color "$preset" "$variant" "water" || true)
  default_bg=$(theme_get_palette_color "$preset" "$variant" "bg" || true)
  
  if [[ -z "$fg" ]] || [[ -z "$bg" ]]; then
    return
  fi
  
  # Write lazygit config
  cat > "$out_file" <<EOF
# Generated from themes.yaml
gui:
  theme:
    activeBorderColor:
      - "${default_fg}"
      - bold
    inactiveBorderColor:
      - "${fg}"
    optionsTextColor:
      - "${default_fg}"
    selectedLineBgColor:
      - "${selected_bg}"
    selectedRangeBgColor:
      - "${selected_bg}"
    cherryPickedCommitBgColor:
      - "${cherry_pick}"
    cherryPickedCommitFgColor:
      - "${default_fg}"
    unTrackedFileBgColor:
      - "${untracked}"
    defaultFgColor:
      - "${fg}"
EOF
}

