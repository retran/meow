# EditorConfig for meow project
# =============================
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Lua files
[*.lua]
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,json}]
indent_size = 2

# Configuration files
[*.{toml,ini,conf}]
indent_size = 2

# Makefiles must use tabs
[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

# Git files
[.gitignore]
indent_size = 2

# Specific files
[LICENSE]
indent_size = 2
