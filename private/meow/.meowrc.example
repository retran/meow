# ==============================================
# Meow Configuration File (.meowrc)
# ==============================================
# This file contains user-specific settings for the meow dotfiles system.
# Copy this file to private/meow/.meowrc and customize as needed.

# Core Feature Toggles
# =====================
# Enable/disable GitHub Copilot integration in supported components
export MEOW_ENABLE_COPILOT="false"

# Enable/disable Mac App Store (mas) package management
export MEOW_ENABLE_MAS="true"

# Package Manager Preferences
# ============================
# Preferred package manager on Linux (auto-detected if not set)
# Options: apt, pacman, apk
export MEOW_PREFERRED_PACKAGE_MANAGER=""

# Installation Behavior
# ======================
# Default installation directory for user binaries
# Will fallback to ~/.local/bin if /usr/local/bin is not writable
export MEOW_USER_BIN_DIR=""

# Skip confirmation prompts during installation (use with caution)
export MEOW_SKIP_CONFIRMATIONS="false"

# Development Environment Preferences
# ====================================
# Default shell (zsh, bash, fish)
export MEOW_DEFAULT_SHELL="zsh"

# Default terminal emulator (alacritty, iterm2, gnome-terminal)
export MEOW_DEFAULT_TERMINAL="alacritty"

# Default editor (nvim, vim, code, subl)
export MEOW_DEFAULT_EDITOR="nvim"

# Git Configuration Overrides
# ============================
# Override git user name (if different from private/git/.gitconfig)
export MEOW_GIT_USERNAME=""

# Override git user email (if different from private/git/.gitconfig)
export MEOW_GIT_EMAIL=""

# Default git protocol (https, ssh)
export MEOW_GIT_PROTOCOL="https"

# Component Customization
# ========================
# Custom component installation order (comma-separated)
export MEOW_COMPONENT_ORDER=""

# Skip specific components during preset installation
export MEOW_SKIP_COMPONENTS=""

# Logging and Debugging
# ======================
# Enable verbose output for all operations
export MEOW_VERBOSE="false"

# Enable debug logging (creates detailed logs)
export MEOW_DEBUG="false"

# Log file location
export MEOW_LOG_FILE="$HOME/.meow.log"

# Backup and Restore
# ===================
# Backup directory for configuration files
export MEOW_BACKUP_DIR="$HOME/.meow-backups"

# Maximum number of backup files to keep
export MEOW_BACKUP_RETENTION="10"

# Update Behavior
# ===============
# Automatically pull git changes during update
export MEOW_AUTO_PULL="true"

# Automatically update package managers during component updates
export MEOW_AUTO_UPDATE_PACKAGES="true"

# Check for meow updates weekly
export MEOW_AUTO_CHECK_UPDATES="true"

# Development and Customization
# ==============================
# Path to user-specific custom components directory
export MEOW_CUSTOM_COMPONENTS_DIR=""

# Path to user-specific custom presets directory
export MEOW_CUSTOM_PRESETS_DIR=""

# Theme and Appearance
# ====================
# Terminal color scheme (dark, light, auto)
export MEOW_COLOR_SCHEME="dark"

# Enable/disable emoji in output
export MEOW_ENABLE_EMOJI="true"

# Network and Security
# =====================
# Use proxy for downloads (format: http://proxy:port)
export MEOW_HTTP_PROXY=""

# Verify SSL certificates (disable only for development)
export MEOW_VERIFY_SSL="true"

# Download timeout in seconds
export MEOW_DOWNLOAD_TIMEOUT="300"
