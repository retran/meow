_meowctl_list_presets() {
  local meow="${MEOW:-$HOME/.meow}"
  if [[ -d "$meow/presets" ]]; then
    find "$meow/presets" -maxdepth 1 -type d -not -name "presets" -exec basename {} \;
  fi
}

_meowctl_list_components() {
  local meow="${MEOW:-$HOME/.meow}"
  if [[ -d "$meow/components" ]]; then
    find "$meow/components" -maxdepth 1 -type d -not -name "components" -exec basename {} \;
  fi
}

_meowctl_list_installed_components() {
  local meow="${MEOW:-$HOME/.meow}"
  if [[ -d "$meow/.installed/components" ]]; then
    find "$meow/.installed/components" -type l -exec basename {} \;
  fi
}

_meowctl_list_theme_presets() {
  local meow="${MEOW:-$HOME/.meow}"
  local theme_db="$meow/themes.yaml"
  
  if [[ -f "$theme_db" ]]; then
    if command -v yq >/dev/null 2>&1; then
      yq eval '.themes | keys | .[]' "$theme_db" 2>/dev/null
    else
      awk '/^themes:/,/^[a-zA-Z]/ { if (/^  [a-zA-Z]/) { gsub(/:/, ""); gsub(/^  /, ""); print } }' "$theme_db" | sort -u
    fi
  fi
}

_meowctl_list_theme_variants() {
  local preset="$1"
  local meow="${MEOW:-$HOME/.meow}"
  local theme_db="$meow/themes.yaml"
  
  if [[ -f "$theme_db" ]]; then
    if command -v yq >/dev/null 2>&1; then
      yq eval ".themes.${preset}.variants | keys | .[]" "$theme_db" 2>/dev/null
    else
      awk "/^  ${preset}:/,/^  [a-zA-Z]/ { if (/^    [a-zA-Z]/ && !/variants:/) { gsub(/:/, \"\"); gsub(/^    /, \"\"); print } }" "$theme_db" | sort -u
    fi
  fi
}

_meowctl_component_commands() {
  local -a commands
  commands=(
    'list:List all available components'
    'status:Show status of all components'
    'install:Install specific components'
    'uninstall:Uninstall specific components'
    'update:Update specific components'
  )
  _describe 'component command' commands
}

_meowctl_theme_commands() {
  local -a commands
  commands=(
    'apply:Apply the current theme'
    'toggle:Toggle between light and dark mode'
    'preset:Apply a specific theme preset'
    'auto:Enable auto mode (follow system appearance)'
    'manual:Enable manual mode'
    'status:Show current theme status'
    'preview:Preview a theme without applying it'
    'list:List all available themes'
    'build:Build theme files from themes.yaml'
  )
  _describe 'theme command' commands
}

_meowctl_config_commands() {
  local -a commands
  commands=(
    'get:Get a configuration value'
    'set:Set a configuration value'
    'list:List all configuration values'
  )
  _describe 'config command' commands
}

_meowctl_backup_commands() {
  local -a commands
  commands=(
    'list:List all backup entries'
    'restore:Restore a backup'
  )
  _describe 'backup command' commands
}

_meowctl() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
    '(--dry-run)--dry-run[Show what would be done without making changes]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1: :->command' \
    '*:: :->args'

  case $state in
    command)
      local -a commands
      commands=(
        'install:Install a preset'
        'update:Update preset or all installed components'
        'uninstall:Uninstall a preset'
        'list:List available presets'
        'component:Manage components'
        'config:Manage meow configuration'
        'theme:Manage themes'
        'backup:Manage symlink backups'
        'help:Show help for command'
      )
      _describe 'meowctl command' commands
      ;;
    args)
      case $words[1] in
        install)
          _arguments \
            '(--force)--force[Force reinstall]' \
            '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
            '(--dry-run)--dry-run[Dry run mode]' \
            '1: :->preset'
          
          case $state in
            preset)
              local -a presets
              presets=(${(f)"$(_meowctl_list_presets)"})
              _describe 'preset' presets
              ;;
          esac
          ;;
        uninstall)
          _arguments \
            '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
            '(--dry-run)--dry-run[Dry run mode]' \
            '1: :->preset'
          
          case $state in
            preset)
              local -a presets
              presets=(${(f)"$(_meowctl_list_presets)"} 'all:Uninstall all presets')
              _describe 'preset' presets
              ;;
          esac
          ;;
        update)
          _arguments \
            '(--pull)--pull[Pull latest changes from git]' \
            '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
            '(--dry-run)--dry-run[Dry run mode]' \
            '*: :->preset'
          
          case $state in
            preset)
              local -a presets
              presets=(${(f)"$(_meowctl_list_presets)"})
              _describe 'preset' presets
              ;;
          esac
          ;;
        component)
          _arguments \
            '1: :->subcommand' \
            '*:: :->component_args'
          
          case $state in
            subcommand)
              _meowctl_component_commands
              ;;
            component_args)
              case $words[1] in
                install|update)
                  local -a components
                  components=(${(f)"$(_meowctl_list_components)"})
                  _describe 'component' components
                  ;;
                uninstall)
                  local -a components
                  components=(${(f)"$(_meowctl_list_installed_components)"})
                  _describe 'installed component' components
                  ;;
              esac
              ;;
          esac
          ;;
        theme)
          _arguments \
            '1: :->subcommand' \
            '*:: :->theme_args'
          
          case $state in
            subcommand)
              _meowctl_theme_commands
              ;;
            theme_args)
              case $words[1] in
                preset)
                  if (( CURRENT == 2 )); then
                    local -a presets
                    presets=(${(f)"$(_meowctl_list_theme_presets)"})
                    _describe 'theme preset' presets
                  elif (( CURRENT == 3 )); then
                    local -a variants
                    variants=(${(f)"$(_meowctl_list_theme_variants "$words[2]")"})
                    _describe 'theme variant' variants
                  elif (( CURRENT == 4 )); then
                    _values 'mode' 'light' 'dark'
                  fi
                  ;;
                preview)
                  if (( CURRENT == 2 )); then
                    local -a presets
                    presets=(${(f)"$(_meowctl_list_theme_presets)"})
                    _describe 'theme preset' presets
                  elif (( CURRENT == 3 )); then
                    local -a variants
                    variants=(${(f)"$(_meowctl_list_theme_variants "$words[2]")"})
                    _describe 'theme variant' variants
                  fi
                  ;;
                build)
                  _arguments \
                    '(--preset)--preset[Specific preset to build]:preset:->preset' \
                    '(--variant)--variant[Specific variant to build]:variant:' \
                    '(--parallel)--parallel[Build in parallel]'
                  
                  case $state in
                    preset)
                      local -a presets
                      presets=(${(f)"$(_meowctl_list_theme_presets)"})
                      _describe 'theme preset' presets
                      ;;
                  esac
                  ;;
              esac
              ;;
          esac
          ;;
        config)
          _arguments \
            '1: :->subcommand' \
            '*:: :->config_args'
          
          case $state in
            subcommand)
              _meowctl_config_commands
              ;;
            config_args)
              case $words[1] in
                get|set)
                  # Complete common config keys
                  local -a config_keys
                  config_keys=(
                    'theme.mode'
                    'theme.current'
                    'theme.light.preset'
                    'theme.light.variant'
                    'theme.dark.preset'
                    'theme.dark.variant'
                  )
                  _describe 'config key' config_keys
                  ;;
              esac
              ;;
          esac
          ;;
        backup)
          _arguments \
            '1: :->subcommand' \
            '*:: :->backup_args'
          
          case $state in
            subcommand)
              _meowctl_backup_commands
              ;;
          esac
          ;;
        help)
          local -a help_topics
          help_topics=(
            'install' 'update' 'uninstall' 'list' 
            'component' 'config' 'theme' 'backup'
          )
          _describe 'command' help_topics
          ;;
      esac
      ;;
  esac
}

_meowctl "$@"
