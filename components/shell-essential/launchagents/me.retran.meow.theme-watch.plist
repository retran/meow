<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.retran.meow.theme-watch</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/retran/.meow/components/shell-essential/scripts/meow-theme-watch</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/tmp/meow-theme-watch.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/meow-theme-watch.error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>MEOW</key>
        <string>/Users/retran/.meow</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
