#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/theme-manager/scripts/meow-theme-watcher
# @brief: Watch macOS appearance and auto-apply themes
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Configuration
MEOW_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/meow"
CONFIG_LIB="${MEOW:-$HOME/.meow}/lib/config/config.sh"
THEME_SCRIPT="${MEOW:-$HOME/.meow}/components/theme-manager/scripts/meow-theme"

# Source config library
source "$CONFIG_LIB"

# Get current macOS appearance
get_macos_appearance() {
    if [[ "$(uname)" != "Darwin" ]]; then
        echo "unknown"
        return 1
    fi
    
    # Read macOS system appearance
    local result
    result=$(defaults read -g AppleInterfaceStyle 2>/dev/null || echo "Light")
    
    if [[ "$result" == "Dark" ]]; then
        echo "dark"
    else
        echo "light"
    fi
}

# Convert appearance to theme mode
appearance_to_mode() {
    local appearance="$1"
    
    if [[ "$appearance" == "dark" ]]; then
        echo "night"
    else
        echo "day"
    fi
}

# Apply theme based on appearance
apply_for_appearance() {
    local appearance="$1"
    local mode
    mode=$(appearance_to_mode "$appearance")
    
    # Get current preset from config
    local preset
    preset=$(meow_config_get "theme.preset" "catppuccin")
    
    # Apply theme
    "$THEME_SCRIPT" apply "$preset" "$mode" 2>&1 | logger -t meow-theme-watcher
}

# Main watcher loop
watch_appearance() {
    local last_appearance
    last_appearance=$(get_macos_appearance)
    
    echo "Starting macOS appearance watcher (current: $last_appearance)"
    echo "Watching for system theme changes..."
    
    while true; do
        sleep 2  # Check every 2 seconds
        
        local current_appearance
        current_appearance=$(get_macos_appearance)
        
        if [[ "$current_appearance" != "$last_appearance" ]]; then
            echo "macOS appearance changed: $last_appearance → $current_appearance"
            apply_for_appearance "$current_appearance"
            last_appearance="$current_appearance"
        fi
    done
}

# Daemon mode with proper background handling
daemon() {
    # Check if auto-sync is enabled
    local auto_sync
    auto_sync=$(meow_config_get "theme.auto_sync" "false")
    
    if [[ "$auto_sync" != "true" ]]; then
        echo "Auto-sync is disabled. Enable with:"
        echo "  meow_config_set theme.auto_sync true"
        exit 0
    fi
    
    # Check if already running
    local pid_file="$MEOW_CONFIG_DIR/theme-watcher.pid"
    if [[ -f "$pid_file" ]]; then
        local old_pid
        old_pid=$(cat "$pid_file")
        if kill -0 "$old_pid" 2>/dev/null; then
            echo "Watcher already running (PID: $old_pid)"
            exit 0
        else
            rm "$pid_file"
        fi
    fi
    
    # Fork to background
    if [[ "${MEOW_THEME_WATCHER_CHILD:-0}" != "1" ]]; then
        echo "Starting theme watcher daemon..."
        MEOW_THEME_WATCHER_CHILD=1 "$0" daemon </dev/null >/dev/null 2>&1 &
        echo $! > "$pid_file"
        echo "Theme watcher started (PID: $!)"
        echo "Logs: tail -f /var/log/system.log | grep meow-theme-watcher"
        exit 0
    fi
    
    # This is the child process
    watch_appearance
}

# Stop daemon
stop() {
    local pid_file="$MEOW_CONFIG_DIR/theme-watcher.pid"
    
    if [[ ! -f "$pid_file" ]]; then
        echo "Watcher is not running"
        exit 0
    fi
    
    local pid
    pid=$(cat "$pid_file")
    
    if kill -0 "$pid" 2>/dev/null; then
        echo "Stopping theme watcher (PID: $pid)..."
        kill "$pid"
        rm "$pid_file"
        echo "Stopped"
    else
        echo "Watcher not running (stale PID file)"
        rm "$pid_file"
    fi
}

# Status check
status() {
    local pid_file="$MEOW_CONFIG_DIR/theme-watcher.pid"
    local auto_sync
    auto_sync=$(meow_config_get "theme.auto_sync" "false")
    
    echo "Auto-sync enabled: $auto_sync"
    
    if [[ -f "$pid_file" ]]; then
        local pid
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Watcher running: yes (PID: $pid)"
        else
            echo "Watcher running: no (stale PID file)"
        fi
    else
        echo "Watcher running: no"
    fi
    
    local current
    current=$(get_macos_appearance)
    echo "Current macOS appearance: $current"
}

# Main command dispatcher
case "${1:-watch}" in
    watch)
        watch_appearance
        ;;
    daemon|start)
        daemon
        ;;
    stop)
        stop
        ;;
    status)
        status
        ;;
    *)
        cat <<EOF
Usage: meow-theme-watcher <command>

Commands:
  watch       Watch appearance changes (foreground)
  daemon      Start as background daemon
  start       Alias for daemon
  stop        Stop daemon
  status      Check status

Configuration:
  meow_config_set theme.auto_sync true   # Enable auto-sync
  meow_config_set theme.auto_sync false  # Disable auto-sync

Examples:
  # Start watching in foreground (for testing)
  meow-theme-watcher watch

  # Start as daemon (background)
  meow-theme-watcher daemon

  # Check status
  meow-theme-watcher status

  # Stop daemon
  meow-theme-watcher stop
EOF
        ;;
esac
