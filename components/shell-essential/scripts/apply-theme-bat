# @file: components/shell-essential/scripts/apply-theme-bat
# @brief: Apply Bat theme
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/bat/themes/${preset_slug}-${variant_slug}.conf"
bat_config="${XDG_CONFIG_HOME:-$HOME/.config}/bat/config"

if [[ ! -f "$theme_file" ]]; then
  echo "bat theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$(dirname "$bat_config")"
cp "$theme_file" "$bat_config"

echo "Applied bat theme: $PRESET/$VARIANT"
