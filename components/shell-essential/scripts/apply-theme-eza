#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/apply-theme-eza
# @brief: Apply eza theme.yml to live config location
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/eza/themes/${preset_slug}-${variant_slug}.yml"

# eza reads theme.yml from $EZA_CONFIG_DIR (defaults to $XDG_CONFIG_HOME/eza or $HOME/.config/eza)
eza_config_dir="${EZA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/eza}"
eza_theme="$eza_config_dir/theme.yml"

if [[ ! -f "$theme_file" ]]; then
  echo "eza theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$eza_config_dir"
cp "$theme_file" "$eza_theme"

echo "Applied eza theme: $PRESET/$VARIANT → $eza_theme"
