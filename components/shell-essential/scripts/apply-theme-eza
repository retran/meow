#!/usr/bin/env bash
set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
MEOW_CONFIG_DIR="${MEOW_CONFIG_DIR:-$HOME/.config/meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/eza/themes/${preset_slug}-${variant_slug}.sh"
eza_config="$MEOW_CONFIG_DIR/eza/colors.sh"

if [[ ! -f "$theme_file" ]]; then
  echo "eza theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$(dirname "$eza_config")"
cp "$theme_file" "$eza_config"

echo "Applied eza theme: $PRESET/$VARIANT"
