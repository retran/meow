#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/apply-theme-starship
# @brief: Apply Starship theme from generated theme files
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Script interface:
# Input: $1=preset, $2=variant
# Environment: $MEOW, $MEOW_CONFIG_DIR
# Output: Copies theme to ~/.config/meow/starship/starship.toml

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
MEOW_CONFIG_DIR="${MEOW_CONFIG_DIR:-$HOME/.config/meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/starship/themes/${preset_slug}-${variant_slug}.toml"
target_file="$MEOW_CONFIG_DIR/starship/starship.toml"

if [[ ! -f "$theme_file" ]]; then
  echo "Starship theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$(dirname "$target_file")"
cp "$theme_file" "$target_file"

echo "Applied starship theme: $PRESET/$VARIANT"
