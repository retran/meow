#!/usr/bin/env bash
set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_DB="${THEME_DB:-$MEOW_ROOT/themes.yaml}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
OUTPUT_DIR="$MEOW_ROOT/components/shell-essential/config/htop/themes"

source "$THEME_LIB"

slugify() {
  local value="$1"
  echo "$value" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g; s/_\+/_/g; s/^_//; s/_$//'
}

mkdir -p "$OUTPUT_DIR"
preset_slug=$(slugify "$PRESET")
variant_slug=$(slugify "$VARIANT")
out_file="$OUTPUT_DIR/${preset_slug}-${variant_slug}.theme"

# Get background color from theme
bg_color=$(theme_get_palette_color "$PRESET" "$VARIANT" "bg" || theme_get_palette_color "$PRESET" "$VARIANT" "bg1" || true)

if [[ -z "$bg_color" ]]; then
  echo "Could not extract required colors for htop theme" >&2
  exit 1
fi

# Detect if dark or light theme (simple brightness check)
color_scheme="5"  # Default to dark (black night)
if [[ -n "$bg_color" ]]; then
  if [[ "$bg_color" =~ ^#[a-fA-F] || "$bg_color" =~ ^#[89] ]]; then
    color_scheme="3"  # Light terminal
  fi
fi

# htop uses predefined color schemes (0-6)
# 0 = default, 1 = monochrome, 2 = black on white, 3 = light terminal
# 4 = MC, 5 = black night, 6 = broken gray
cat > "$out_file" <<EOF
# Generated from themes.yaml
# htop color scheme
# Note: htop has limited theming - uses predefined color schemes
color_scheme=${color_scheme}
# htop has limited theming capabilities
# Only basic color scheme selection is supported
EOF

echo "Generated: $out_file"
