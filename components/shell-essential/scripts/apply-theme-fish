#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/apply-theme-fish
# @brief: Apply a generated fish colour theme by executing its universal-variable file.
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
theme_file="$MEOW_ROOT/components/shell-essential/config/fish/themes/${preset_slug}-${variant_slug}.fish"

if [[ ! -f "$theme_file" ]]; then
  echo "Fish theme not found: $theme_file" >&2
  exit 1
fi

# Execute the theme file with fish to set universal variables.
if command -v fish >/dev/null 2>&1; then
  fish "$theme_file"
  echo "Applied fish theme: $PRESET/$VARIANT"
else
  echo "fish not found in PATH — cannot apply theme" >&2
  exit 1
fi
