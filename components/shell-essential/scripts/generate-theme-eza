#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/generate-theme-eza
# @brief: Generate eza theme.yml files from themes.yaml
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Script interface:
# Input: $1=preset, $2=variant
# Environment: $MEOW, $THEME_LIB, $THEME_UTILS
# Output: Writes to $MEOW/components/shell-essential/config/eza/themes/

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"
OUTPUT_DIR="$MEOW_ROOT/components/shell-essential/config/eza/themes"

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Theme library not found: $THEME_LIB" >&2
  exit 1
fi

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_LIB"
source "$THEME_UTILS"

mkdir -p "$OUTPUT_DIR"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
out_file="$OUTPUT_DIR/${preset_slug}-${variant_slug}.yml"

# ── Color resolution helper ───────────────────────────────────────────────────

get_color() {
  local result=""
  for key in "$@"; do
    result=$(theme_get_palette_color "$PRESET" "$VARIANT" "$key" 2>/dev/null || true)
    if [[ -n "$result" && "$result" != "null" ]]; then
      echo "$result"
      return
    fi
  done
  echo ""
}

# ── Resolve semantic palette colors ──────────────────────────────────────────

text=$(get_color     "text"     "fg"       "fg1")
subtext0=$(get_color "subtext0" "comment"  "overlay1")
subtext1=$(get_color "subtext1" "subtext0" "fg_muted")
surface1=$(get_color "surface1" "surface0" "bg_highlight")
surface2=$(get_color "surface2" "surface1" "overlay0")
overlay0=$(get_color "overlay0" "comment"  "gray"     "dark5")
overlay1=$(get_color "overlay1" "overlay0" "comment")
overlay2=$(get_color "overlay2" "overlay1" "overlay0")

red=$(get_color      "red"      "rose"     "love"    "error")
green=$(get_color    "green"    "leaf"     "teal")
yellow=$(get_color   "yellow"   "gold"     "wood")
blue=$(get_color     "blue"     "water"    "sapphire" "sky")
mauve=$(get_color    "mauve"    "purple"   "blossom"  "iris"    "blue")
peach=$(get_color    "peach"    "orange"   "flamingo")
teal=$(get_color     "teal"     "cyan"     "foam"     "water")
sky=$(get_color      "sky"      "cyan"     "teal"     "water")
sapphire=$(get_color "sapphire" "blue"     "sky"      "teal")
maroon=$(get_color   "maroon"   "red"      "rose")
lavender=$(get_color "lavender" "blue"     "sapphire")
flamingo=$(get_color "flamingo" "pink"     "rosewater")
pink=$(get_color     "pink"     "flamingo" "mauve")

# Fallbacks
[[ -z "$text"     ]] && text="#cdd6f4"
[[ -z "$subtext0" ]] && subtext0="#a6adc8"
[[ -z "$subtext1" ]] && subtext1="#bac2de"
[[ -z "$surface1" ]] && surface1="#45475a"
[[ -z "$surface2" ]] && surface2="#585b70"
[[ -z "$overlay0" ]] && overlay0="#6c7086"
[[ -z "$overlay1" ]] && overlay1="#7f849c"
[[ -z "$overlay2" ]] && overlay2="#9399b2"
[[ -z "$red"      ]] && red="#f38ba8"
[[ -z "$green"    ]] && green="#a6e3a1"
[[ -z "$yellow"   ]] && yellow="#f9e2af"
[[ -z "$blue"     ]] && blue="#89b4fa"
[[ -z "$mauve"    ]] && mauve="#cba6f7"
[[ -z "$peach"    ]] && peach="#fab387"
[[ -z "$teal"     ]] && teal="#94e2d5"
[[ -z "$sky"      ]] && sky="#89dceb"
[[ -z "$sapphire" ]] && sapphire="#74c7ec"
[[ -z "$maroon"   ]] && maroon="#eba0ac"
[[ -z "$lavender" ]] && lavender="#b4befe"
[[ -z "$flamingo" ]] && flamingo="#f2cdcd"
[[ -z "$pink"     ]] && pink="#f5c2e7"

# ── Emit YAML theme ───────────────────────────────────────────────────────────

cat > "$out_file" <<EOF
# Generated from themes.yaml — ${PRESET}/${VARIANT}
colourful: true

filekinds:
  normal: {foreground: "${text}"}
  directory: {foreground: "${mauve}"}
  symlink: {foreground: "${blue}"}
  pipe: {foreground: "${subtext1}"}
  block_device: {foreground: "${maroon}"}
  char_device: {foreground: "${maroon}"}
  socket: {foreground: "${subtext1}"}
  special: {foreground: "${mauve}"}
  executable: {foreground: "${green}"}
  mount_point: {foreground: "${teal}"}

perms:
  user_read: {foreground: "${red}", is_bold: true}
  user_write: {foreground: "${yellow}", is_bold: true}
  user_execute_file: {foreground: "${green}", is_bold: true}
  user_execute_other: {foreground: "${green}", is_bold: true}
  group_read: {foreground: "${red}"}
  group_write: {foreground: "${yellow}"}
  group_execute: {foreground: "${green}"}
  other_read: {foreground: "${red}"}
  other_write: {foreground: "${yellow}"}
  other_execute: {foreground: "${green}"}
  special_user_file: {foreground: "${mauve}"}
  special_other: {foreground: "${overlay1}"}
  attribute: {foreground: "${overlay2}"}

size:
  major: {foreground: "${subtext0}"}
  minor: {foreground: "${sky}"}
  number_byte: {foreground: "${subtext1}"}
  number_kilo: {foreground: "${subtext0}"}
  number_mega: {foreground: "${blue}"}
  number_giga: {foreground: "${mauve}"}
  number_huge: {foreground: "${mauve}"}
  unit_byte: {foreground: "${subtext0}"}
  unit_kilo: {foreground: "${sky}"}
  unit_mega: {foreground: "${mauve}"}
  unit_giga: {foreground: "${mauve}"}
  unit_huge: {foreground: "${teal}"}

users:
  user_you: {foreground: "${text}"}
  user_root: {foreground: "${red}"}
  user_other: {foreground: "${maroon}"}
  group_yours: {foreground: "${subtext0}"}
  group_other: {foreground: "${overlay2}"}
  group_root: {foreground: "${red}"}

links:
  normal: {foreground: "${blue}"}
  multi_link_file: {foreground: "${blue}"}

git:
  new: {foreground: "${green}"}
  modified: {foreground: "${yellow}"}
  deleted: {foreground: "${maroon}"}
  renamed: {foreground: "${teal}"}
  typechange: {foreground: "${pink}"}
  ignored: {foreground: "${overlay1}"}
  conflicted: {foreground: "${peach}"}

git_repo:
  branch_main: {foreground: "${subtext0}"}
  branch_other: {foreground: "${mauve}"}
  git_clean: {foreground: "${green}"}
  git_dirty: {foreground: "${maroon}"}

security_context:
  colon: {foreground: "${overlay0}"}
  user: {foreground: "${overlay1}"}
  role: {foreground: "${mauve}"}
  typ: {foreground: "${surface2}"}
  range: {foreground: "${mauve}"}

file_type:
  image: {foreground: "${yellow}"}
  video: {foreground: "${red}"}
  music: {foreground: "${green}"}
  lossless: {foreground: "${teal}"}
  crypto: {foreground: "${overlay1}"}
  document: {foreground: "${text}"}
  compressed: {foreground: "${pink}"}
  temp: {foreground: "${maroon}"}
  compiled: {foreground: "${sapphire}"}
  source: {foreground: "${blue}"}

punctuation: {foreground: "${overlay0}"}
date: {foreground: "${yellow}"}
inode: {foreground: "${subtext0}"}
blocks: {foreground: "${overlay0}"}
header: {foreground: "${text}"}
octal: {foreground: "${teal}"}
flags: {foreground: "${mauve}"}

symlink_path: {foreground: "${sky}"}
control_char: {foreground: "${sapphire}"}
broken_symlink: {foreground: "${red}"}
broken_path_overlay: {foreground: "${surface2}"}
EOF

echo "Generated: $out_file"
