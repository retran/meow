#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"
OUTPUT_DIR="$MEOW_ROOT/components/shell-essential/config/lazygit/themes"

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Theme library not found: $THEME_LIB" >&2
  exit 1
fi

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_LIB"
source "$THEME_UTILS"

mkdir -p "$OUTPUT_DIR"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
out_file="$OUTPUT_DIR/${preset_slug}-${variant_slug}.yml"

# Get colors with fallback chains
fg=$(theme_get_palette_color "$PRESET" "$VARIANT" "fg" || \
     theme_get_palette_color "$PRESET" "$VARIANT" "fg1" || \
     theme_get_terminal_color "$PRESET" "$VARIANT" "7" || \
     echo "ffffff")

bg=$(theme_get_palette_color "$PRESET" "$VARIANT" "bg" || \
     theme_get_palette_color "$PRESET" "$VARIANT" "bg1" || \
     theme_get_terminal_color "$PRESET" "$VARIANT" "0" || \
     echo "000000")

selected_bg=$(theme_get_palette_color "$PRESET" "$VARIANT" "bg_highlight" || \
              theme_get_palette_color "$PRESET" "$VARIANT" "bg_visual" || \
              theme_get_palette_color "$PRESET" "$VARIANT" "selection_bg" || \
              theme_get_terminal_color "$PRESET" "$VARIANT" "8" || \
              echo "444444")

cherry_pick=$(theme_get_palette_color "$PRESET" "$VARIANT" "cyan" || \
              theme_get_palette_color "$PRESET" "$VARIANT" "water" || \
              theme_get_terminal_color "$PRESET" "$VARIANT" "6" || \
              echo "00ffff")

untracked=$(theme_get_palette_color "$PRESET" "$VARIANT" "red" || \
            theme_get_palette_color "$PRESET" "$VARIANT" "rose" || \
            theme_get_terminal_color "$PRESET" "$VARIANT" "1" || \
            echo "ff0000")

default_fg=$(theme_get_palette_color "$PRESET" "$VARIANT" "blue" || \
             theme_get_palette_color "$PRESET" "$VARIANT" "water" || \
             theme_get_terminal_color "$PRESET" "$VARIANT" "4" || \
             echo "0000ff")

cat > "$out_file" <<EOF
# Generated from themes.yaml
gui:
  theme:
    activeBorderColor:
      - "${default_fg}"
      - bold
    inactiveBorderColor:
      - "${fg}"
    optionsTextColor:
      - "${default_fg}"
    selectedLineBgColor:
      - "${selected_bg}"
    selectedRangeBgColor:
      - "${selected_bg}"
    cherryPickedCommitBgColor:
      - "${cherry_pick}"
    cherryPickedCommitFgColor:
      - "${default_fg}"
    unTrackedFileBgColor:
      - "${untracked}"
    defaultFgColor:
      - "${fg}"
EOF

echo "Generated: $out_file"
