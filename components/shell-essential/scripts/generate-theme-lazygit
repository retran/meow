#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/generate-theme-lazygit
# @brief: Generate lazygit theme files from themes.yaml
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"
OUTPUT_DIR="$MEOW_ROOT/components/shell-essential/config/lazygit/themes"

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Theme library not found: $THEME_LIB" >&2
  exit 1
fi

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_LIB"
source "$THEME_UTILS"

mkdir -p "$OUTPUT_DIR"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
out_file="$OUTPUT_DIR/${preset_slug}-${variant_slug}.yml"

# ── Color resolution helper ───────────────────────────────────────────────────

get_color() {
  local result=""
  for key in "$@"; do
    result=$(theme_get_palette_color "$PRESET" "$VARIANT" "$key" 2>/dev/null || true)
    if [[ -n "$result" && "$result" != "null" ]]; then
      echo "$result"
      return
    fi
  done
  echo ""
}

# ── Resolve lazygit color roles (official catppuccin/lazygit mapping) ─────────
# accent = mauve for catppuccin; falls back to blue/purple for other themes

accent=$(get_color   "mauve"    "purple"   "blossom"  "iris"     "blue")
text=$(get_color     "text"     "fg"       "fg1")
subtext0=$(get_color "subtext0" "comment"  "overlay1" "overlay0" "fg_muted")
surface0=$(get_color "surface0" "bg_highlight" "bg_visual" "selection_bg")
surface1=$(get_color "surface1" "surface0" "surface2" "bg_highlight")
red=$(get_color      "red"      "rose"     "love"     "error")
yellow=$(get_color   "yellow"   "gold"     "wood"     "peach")
lavender=$(get_color "lavender" "blue"     "sapphire" "sky"      "mauve")

# Fallbacks
[[ -z "$accent"   ]] && accent="#89b4fa"
[[ -z "$text"     ]] && text="#cdd6f4"
[[ -z "$subtext0" ]] && subtext0="#a6adc8"
[[ -z "$surface0" ]] && surface0="#313244"
[[ -z "$surface1" ]] && surface1="#45475a"
[[ -z "$red"      ]] && red="#f38ba8"
[[ -z "$yellow"   ]] && yellow="#f9e2af"
[[ -z "$lavender" ]] && lavender="#b4befe"

cat > "$out_file" <<EOF
# Generated from themes.yaml — ${PRESET}/${VARIANT}
gui:
  theme:
    activeBorderColor:
      - "${accent}"
      - bold
    inactiveBorderColor:
      - "${subtext0}"
    searchingActiveBorderColor:
      - "${yellow}"
      - bold
    optionsTextColor:
      - "${accent}"
    selectedLineBgColor:
      - "${surface0}"
    cherryPickedCommitBgColor:
      - "${surface1}"
    cherryPickedCommitFgColor:
      - "${accent}"
    unstagedChangesColor:
      - "${red}"
    defaultFgColor:
      - "${text}"
  authorColors:
    '*': "${lavender}"
EOF

echo "Generated: $out_file"
