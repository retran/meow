#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/generate-theme-fish
# @brief: Generate fish universal variable colour files from themes.yaml
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"
OUTPUT_DIR="$MEOW_ROOT/components/shell-essential/config/fish/themes"

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Theme library not found: $THEME_LIB" >&2
  exit 1
fi

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_LIB"
source "$THEME_UTILS"

mkdir -p "$OUTPUT_DIR"
preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
out_file="$OUTPUT_DIR/${preset_slug}-${variant_slug}.fish"

# Retrieve terminal colours (ANSI 0-15) from themes.yaml.
# Fish uses named set -U variables for its colour scheme.
# We map the 16-colour palette to fish_color_* universal variables.

get_color() {
  local name="$1"
  theme_get_palette_color "$PRESET" "$VARIANT" "$name" 2>/dev/null || true
}

get_terminal() {
  local idx="$1"
  theme_get_terminal_color "$PRESET" "$VARIANT" "$idx" 2>/dev/null || true
}

# Semantic colour lookup helpers
normal=$(get_color "fg" || get_color "fg1" || get_terminal "7" || echo "")
black=$(get_terminal "0" || echo "")
red=$(get_terminal "1" || get_color "red" || get_color "rose" || echo "")
green=$(get_terminal "2" || get_color "green" || get_color "leaf" || echo "")
yellow=$(get_terminal "3" || get_color "yellow" || get_color "wood" || echo "")
blue=$(get_terminal "4" || get_color "blue" || get_color "blue1" || echo "")
magenta=$(get_terminal "5" || get_color "purple" || get_color "blossom" || echo "")
cyan=$(get_terminal "6" || get_color "cyan" || get_color "water" || echo "")
white=$(get_terminal "7" || get_color "fg" || echo "")
bg=$(get_color "bg" || get_color "bg1" || get_terminal "0" || echo "")
comment=$(get_color "gray" || get_color "subtle" || get_color "comment" || get_terminal "8" || echo "")

# Helper: emit a set -U line only if colour is non-empty
_emit() {
  local var="$1" val="$2"
  if [[ -n "$val" ]]; then
    echo "set -U $var '$val'"
  fi
}

cat > "$out_file" <<HEADER
# Generated from themes.yaml — $PRESET / $VARIANT
# Apply with: fish $out_file
# This file sets fish universal colour variables.

HEADER

{
  # Standard fish_color_* variables
  _emit fish_color_normal        "$normal"
  _emit fish_color_command       "$blue"
  _emit fish_color_keyword       "$magenta"
  _emit fish_color_quote         "$green"
  _emit fish_color_redirection   "$cyan"
  _emit fish_color_end           "$white"
  _emit fish_color_error         "$red"
  _emit fish_color_param         "$cyan"
  _emit fish_color_valid_path    "--underline"
  _emit fish_color_option        "$cyan"
  _emit fish_color_comment       "$comment"
  _emit fish_color_selection     "--background=$comment"
  _emit fish_color_search_match  "--background=$yellow"
  _emit fish_color_operator      "$cyan"
  _emit fish_color_escape        "$magenta"
  _emit fish_color_autosuggestion "$comment"
  _emit fish_color_cancel        "$red"
  _emit fish_color_history_current "--bold"

  # Pager colours
  _emit fish_pager_color_progress    "$comment"
  _emit fish_pager_color_background  ""
  _emit fish_pager_color_prefix      "normal --bold --underline"
  _emit fish_pager_color_completion  "$normal"
  _emit fish_pager_color_description "$yellow"
  _emit fish_pager_color_selected_background "--background=$comment"
  _emit fish_pager_color_selected_prefix     "normal --bold --underline"
  _emit fish_pager_color_selected_completion "$normal"
} >> "$out_file"

echo "Generated: $out_file"
