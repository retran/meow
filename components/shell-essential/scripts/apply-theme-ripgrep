#!/usr/bin/env bash
set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/ripgrep/themes/${preset_slug}-${variant_slug}.rc"
base_config="$MEOW_ROOT/components/shell-essential/config/ripgrep/.ripgreprc"
rg_config="$HOME/.ripgreprc"

if [[ ! -f "$theme_file" ]]; then
  echo "ripgrep theme not found: $theme_file" >&2
  exit 1
fi

# Start with base config if it exists, otherwise start empty
temp_file=$(mktemp)
trap 'rm -f "$temp_file"' EXIT

if [[ -f "$base_config" ]]; then
  # Copy base config, stripping everything from the generated theme marker onward
  awk '/^# Generated from themes\.yaml/{exit} {print}' "$base_config" > "$temp_file" 2>/dev/null || true
fi

# Append theme colors
cat "$theme_file" >> "$temp_file"
cp "$temp_file" "$rg_config"

echo "Applied ripgrep theme: $PRESET/$VARIANT"
