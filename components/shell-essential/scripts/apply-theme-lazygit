set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
MEOW_CONFIG_DIR="${MEOW_CONFIG_DIR:-$HOME/.config/meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/shell-essential/config/lazygit/themes/${preset_slug}-${variant_slug}.yml"
lazygit_config="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml"

if [[ ! -f "$theme_file" ]]; then
  echo "lazygit theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$(dirname "$lazygit_config")"
cp "$theme_file" "$lazygit_config"

echo "Applied lazygit theme: $PRESET/$VARIANT"
