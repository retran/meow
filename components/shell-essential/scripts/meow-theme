# @file: components/shell-essential/scripts/meow-theme
# @brief: Thin wrapper around theme-manager for interactive theme management
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

MEOW="${MEOW:-$HOME/.meow}"
THEME_MANAGER="$MEOW/lib/theme/theme-manager.sh"

if [[ ! -f "$THEME_MANAGER" ]]; then
  echo "Error: Theme manager not found at $THEME_MANAGER" >&2
  exit 1
fi

# Source theme manager library
source "$THEME_MANAGER"

# Initialize theme system
theme_init || exit 1
ensure_theme_defaults

# Main command dispatch
main() {
  case "${1:-apply}" in
    apply|"")
      apply_current
      ;;
    toggle)
      toggle_mode
      ;;
    preset)
      if [[ $# -lt 3 ]]; then
        echo "Usage: meow-theme preset <preset> <variant> [light|dark]" >&2
        echo "" >&2
        echo "Available presets:" >&2
        theme_list_presets | sed 's/^/  - /' >&2
        exit 1
      fi
      apply_preset "$2" "$3" "${4:-}"
      ;;
    auto)
      enable_auto_mode
      ;;
    manual)
      enable_manual_mode
      ;;
    status)
      show_status
      ;;
    preview)
      if [[ $# -lt 3 ]]; then
        echo "Usage: meow-theme preview <preset> <variant>" >&2
        echo "" >&2
        echo "Available presets:" >&2
        theme_list_presets | sed 's/^/  - /' >&2
        exit 1
      fi
      preview_theme "$2" "$3"
      ;;
    list)
      list_themes
      ;;
    *)
      cat <<EOF
Usage: meow-theme [command] [arguments]

Commands:
  apply                         Apply the current theme (default)
  toggle                        Toggle between light and dark mode
  preset <preset> <variant> [mode]
                                Apply a specific theme preset
  auto                          Enable auto mode (follow system appearance)
  manual                        Enable manual mode (lock current theme)
  status                        Show current theme status
  preview <preset> <variant>    Preview a theme without applying it
  list                          List all available themes

Examples:
  meow-theme
  meow-theme apply
  meow-theme toggle
  meow-theme preset catppuccin mocha
  meow-theme preset catppuccin latte light
  meow-theme preview tokyonight moon
  meow-theme list
  meow-theme auto
  meow-theme manual
  meow-theme status

Environment Variables:
  MEOW_DEBUG=true               Enable debug output
  MEOW_THEME_LOGGING=true       Enable theme change logging

For more information, see: ~/.meow/docs/themes.md
EOF
      exit 1
      ;;
  esac
}

main "$@"
