#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/shell-essential/scripts/apply-theme-btop
# @brief: Apply a generated btop theme by copying it into ~/.config/btop/themes/
#         and updating the color_theme entry in btop.conf.
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

src_theme="$MEOW_ROOT/components/shell-essential/config/btop/themes/${preset_slug}-${variant_slug}.theme"
btop_theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes"
btop_conf="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"

if [[ ! -f "$src_theme" ]]; then
  echo "btop theme not found: $src_theme" >&2
  exit 1
fi

mkdir -p "$btop_theme_dir"

# Copy the generated theme file
cp "$src_theme" "$btop_theme_dir/meow.theme"

# Update color_theme in btop.conf if it exists
if [[ -f "$btop_conf" ]]; then
  tmp=$(mktemp)
  # Replace existing color_theme line
  sed 's|^color_theme = .*|color_theme = "meow"|' "$btop_conf" > "$tmp"
  mv "$tmp" "$btop_conf"
fi

echo "Applied btop theme: $PRESET/$VARIANT"
