#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/tmux/scripts/tmux-weather
# @brief: Get weather icon and temperature for tmux status bar
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Cache file and duration (15 minutes)
CACHE_FILE="${TMPDIR:-/tmp}/tmux-weather-cache"
CACHE_DURATION=900

# Check if cache is valid
if [[ -f "$CACHE_FILE" ]]; then
  cache_age=$(($(date +%s) - $(stat -f %m "$CACHE_FILE" 2>/dev/null || stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)))
  if [[ $cache_age -lt $CACHE_DURATION ]]; then
    cat "$CACHE_FILE"
    exit 0
  fi
fi

# Fetch weather using wttr.in
# Format: %C = weather condition text, %t = temperature
weather_data=$(curl -sf "wttr.in/?format=%C|%t" 2>/dev/null || echo "")

if [[ -n "$weather_data" ]]; then
  condition=$(echo "$weather_data" | cut -d'|' -f1 | tr '[:upper:]' '[:lower:]')
  temp=$(echo "$weather_data" | cut -d'|' -f2 | sed 's/ //g')
  
  # Map weather conditions to monochrome nerd font icons
  case "$condition" in
    *clear*|*sunny*)
      icon="$(printf '\uf185')"  # nf-fa-sun
      ;;
    *partly*cloudy*|*cloudy*)
      icon="$(printf '\uf0c2')"  # nf-fa-cloud
      ;;
    *overcast*)
      icon="$(printf '\uf0c2')"  # nf-fa-cloud
      ;;
    *rain*|*drizzle*)
      icon="$(printf '\uf0e9')"  # nf-fa-umbrella
      ;;
    *snow*)
      icon="$(printf '\uf2dc')"  # nf-fa-snowflake_o
      ;;
    *thunder*|*storm*)
      icon="$(printf '\uf0e7')"  # nf-fa-bolt
      ;;
    *fog*|*mist*)
      icon="$(printf '\uf75f')"  # nf-mdi-weather_fog
      ;;
    *)
      icon="$(printf '\uf059')"  # nf-fa-question_circle
      ;;
  esac
  
  output="$icon $temp"
  echo "$output" > "$CACHE_FILE"
  echo "$output"
else
  # Fallback if no weather data
  [[ -f "$CACHE_FILE" ]] && cat "$CACHE_FILE" || echo " ?"
fi
