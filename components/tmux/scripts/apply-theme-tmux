# @file: components/tmux/scripts/apply-theme-tmux
# @brief: Apply Tmux theme
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
MEOW_CONFIG_DIR="${MEOW_CONFIG_DIR:-$HOME/.config/meow}"

slugify() {
  local value="$1"
  value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
  value=$(echo "$value" | sed 's/[^a-z0-9]/_/g; s/_\+/_/g; s/^_//; s/_$//')
  echo "$value"
}

preset_slug=$(slugify "$PRESET")
variant_slug=$(slugify "$VARIANT")

theme_file="$MEOW_ROOT/components/tmux/config/themes/${preset_slug}-${variant_slug}.conf"
target_file="$MEOW_CONFIG_DIR/tmux/theme.conf"

if [[ ! -f "$theme_file" ]]; then
  echo "Tmux theme not found: $theme_file" >&2
  exit 1
fi

mkdir -p "$(dirname "$target_file")"
cp "$theme_file" "$target_file"

# Reload tmux if running
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  # Just reload the theme file - the main config doesn't need reloading
  tmux source-file "$target_file" 2>/dev/null || true
fi

echo "Applied tmux theme: $PRESET/$VARIANT"
