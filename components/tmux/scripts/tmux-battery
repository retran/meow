#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/tmux/scripts/tmux-battery
# @brief: Get battery status and percentage for tmux status bar
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Check if running on macOS
if [[ "$(uname -s)" == "Darwin" ]]; then
  # macOS battery info
  battery_info=$(pmset -g batt | grep -Eo "\d+%" | head -n 1)
  battery_percent=${battery_info%%%}
  
  # Check if charging
  if pmset -g batt | grep -q "AC Power"; then
    icon="󰂄"  # Charging
  else
    # Select icon based on percentage
    if [[ $battery_percent -ge 90 ]]; then
      icon="󰁹"
    elif [[ $battery_percent -ge 70 ]]; then
      icon="󰂁"
    elif [[ $battery_percent -ge 50 ]]; then
      icon="󰁿"
    elif [[ $battery_percent -ge 30 ]]; then
      icon="󰁽"
    elif [[ $battery_percent -ge 10 ]]; then
      icon="󰁻"
    else
      icon="󰂎"  # Low battery
    fi
  fi
  
  echo "$icon $battery_percent%"
else
  # Linux battery info (using /sys/class/power_supply/)
  if [[ -d /sys/class/power_supply/BAT0 ]]; then
    battery_percent=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "0")
    status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "Unknown")
    
    if [[ "$status" == "Charging" ]]; then
      icon="󰂄"
    else
      if [[ $battery_percent -ge 90 ]]; then
        icon="󰁹"
      elif [[ $battery_percent -ge 70 ]]; then
        icon="󰂁"
      elif [[ $battery_percent -ge 50 ]]; then
        icon="󰁿"
      elif [[ $battery_percent -ge 30 ]]; then
        icon="󰁽"
      elif [[ $battery_percent -ge 10 ]]; then
        icon="󰁻"
      else
        icon="󰂎"
      fi
    fi
    
    echo "$icon $battery_percent%"
  else
    # No battery detected
    echo ""
  fi
fi
