font-family = "JetBrainsMono Nerd Font Mono"
font-style = "SemiBold"
font-size = 14

# cursor/selection colors will be derived from theme

background-opacity = 1.0

title = "meow - Purr-fect Development Environment"

window-width = 120
window-height = 40

# Match Alacritty's `option_as_alt = "OnlyLeft"`.
macos-option-as-alt = left

# theme: meow
# palette entries are managed by meowctl theme
# endtheme: meow
