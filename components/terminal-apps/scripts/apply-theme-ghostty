#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/terminal-apps/scripts/apply-theme-ghostty
# @brief: Update Ghostty theme name line for user-initiated preset changes.
#         Day/night switching is handled natively by Ghostty via macOS NSAppearance.
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"
MODE="${3:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant> [light|dark]" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

source "$THEME_UTILS"

# Infer mode from $3 or from meow config
if [[ -z "$MODE" ]]; then
  CONFIG_LIB="$MEOW_ROOT/lib/config/config.sh"
  if [[ -f "$CONFIG_LIB" ]]; then
    source "$CONFIG_LIB" 2>/dev/null || true
    MODE=$(meow_config_get "theme.current" "dark" 2>/dev/null || echo "dark")
  else
    MODE="dark"
  fi
fi

if [[ "$MODE" != "light" && "$MODE" != "dark" ]]; then
  echo "Invalid mode: $MODE (use light or dark)" >&2
  exit 1
fi

ghostty_config="${GHOSTTY_CONFIG_DIR:-$HOME/.config/ghostty}/config"

if [[ ! -f "$ghostty_config" ]]; then
  echo "Ghostty config not found: $ghostty_config" >&2
  exit 0
fi

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")
new_theme_name="${preset_slug}-${variant_slug}"

# Verify the theme file exists in the themes directory
themes_dir="$(dirname "$ghostty_config")/themes"
if [[ ! -f "$themes_dir/${new_theme_name}.conf" ]]; then
  echo "Ghostty theme file not found: $themes_dir/${new_theme_name}.conf" >&2
  echo "Run: meowctl theme build --preset $PRESET --variant $VARIANT" >&2
  exit 1
fi

# Read the current theme = light:X,dark:Y line, extract the other slot
current_line=$(grep -E '^theme\s*=' "$ghostty_config" 2>/dev/null | tail -1 || echo "")

extract_slot() {
  local line="$1"
  local slot="$2"
  echo "$line" | sed -n "s/.*${slot}:\([^,)]*\).*/\1/p" | tr -d ' '
}

if [[ "$MODE" == "light" ]]; then
  other_slot=$(extract_slot "$current_line" "dark")
  [[ -z "$other_slot" ]] && other_slot="catppuccin-macchiato"
  new_line="theme = light:${new_theme_name},dark:${other_slot}"
else
  other_slot=$(extract_slot "$current_line" "light")
  [[ -z "$other_slot" ]] && other_slot="catppuccin-latte"
  new_line="theme = light:${other_slot},dark:${new_theme_name}"
fi

# Update or insert the theme line
if grep -qE '^theme[[:space:]]*=' "$ghostty_config"; then
  # Replace existing theme line; escape replacement string to guard against
  # sed special chars (&, \) in theme names.
  new_line_escaped=$(printf '%s\n' "$new_line" | sed 's/[&\\/]/\\&/g')
  temp_file=$(mktemp)
  trap 'rm -f "$temp_file"' EXIT
  sed -E "s|^theme[[:space:]]*=.*|${new_line_escaped}|" "$ghostty_config" > "$temp_file"
  mv "$temp_file" "$ghostty_config"
else
  echo "$new_line" >> "$ghostty_config"
fi

# Reload Ghostty config (needed for user-initiated preset changes)
if command -v pkill >/dev/null 2>&1; then
  pkill -SIGUSR2 ghostty >/dev/null 2>&1 || true
fi

echo "Applied Ghostty theme: $PRESET/$VARIANT ($MODE)"
