#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/terminal-apps/scripts/apply-theme-ghostty
# @brief: Apply Ghostty theme from pre-generated themes
# @author: Andrew Vasilyev
# @license: MIT

set -euo pipefail

# Script interface:
# Input: $1=preset, $2=variant
# Environment: $MEOW, $MEOW_CONFIG_DIR
# Output: Writes to ~/.config/meow/ghostty/theme.conf

PRESET="${1:-}"
VARIANT="${2:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant>" >&2
  exit 1
fi

slugify() {
  local value="$1"
  value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
  value=$(echo "$value" | sed 's/[^a-z0-9]/_/g; s/_\+/_/g; s/^_//; s/_$//')
  echo "$value"
}

MEOW_ROOT="${MEOW:-$HOME/.meow}"
MEOW_CONFIG_DIR="${MEOW_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/meow}"

preset_slug=$(slugify "$PRESET")
variant_slug=$(slugify "$VARIANT")

# Source: pre-generated theme file
theme_file="$MEOW_ROOT/.installed/components/terminal-apps/config/ghostty/themes/${preset_slug}-${variant_slug}.conf"

if [[ ! -f "$theme_file" ]]; then
  echo "Theme file not found: $theme_file" >&2
  echo "Run 'meowctl theme build' to generate themes first." >&2
  exit 1
fi

# Target: dynamic theme file (not symlinked)
output_dir="$MEOW_CONFIG_DIR/ghostty"
output_file="$output_dir/theme.conf"

mkdir -p "$output_dir"

# Copy the pre-generated theme to the runtime location
cp "$theme_file" "$output_file"

# Send reload signal to Ghostty if running
if command -v pkill >/dev/null 2>&1; then
  pkill -SIGUSR2 ghostty >/dev/null 2>&1 || true
fi

exit 0
