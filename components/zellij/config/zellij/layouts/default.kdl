// @file: components/zellij/config/zellij/layouts/default.kdl
// @brief: Default zellij layout with zjstatus status bar at the top.
// @author: Andrew Vasilyev
// @license: MIT
//
// Prerequisites:
//   Download zjstatus.wasm from https://github.com/dj95/zjstatus/releases
//   and place it at ~/.config/zellij/plugins/zjstatus.wasm

layout {
    default_tab_template {
        // Status bar at the TOP (declared before children)
        pane size=2 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                format_left   "{tabs}"
                format_center ""
                format_right  "{command_weather} {command_cpu} {command_mem} {command_bat} {datetime}"

                border_enabled  "false"
                hide_frame_for_single_pane "false"
                mode_default_to_mode "normal"

                // Weather via wttr.in (Amsterdam), refresh every 30 minutes
                command_weather_command  "bash -c \"curl -s 'wttr.in/Amsterdam?format=1' 2>/dev/null || echo '?'\""
                command_weather_interval "1800"
                command_weather_rendermode "static"

                // CPU usage (macOS: top snapshot)
                command_cpu_command  "bash -c \"top -l 1 -s 0 | awk '/CPU usage/ {print $3}' | tr -d '%'\""
                command_cpu_interval "5"
                command_cpu_rendermode "static"

                // Memory usage (macOS: vm_stat)
                command_mem_command  "bash -c \"python3 -c \\\"import subprocess; lines = subprocess.check_output(['vm_stat']).decode().splitlines(); pages = {l.split(':')[0].strip(): int(l.split(':')[1].strip().rstrip('.')) for l in lines[1:] if ':' in l}; used = (pages.get('Pages active',0)+pages.get('Pages wired down',0)+pages.get('Pages occupied by compressor',0))*4096//1048576; print(used)\\\"\""
                command_mem_interval "10"
                command_mem_rendermode "static"

                // Battery (macOS: pmset) — dynamic icon by level and charge state
                command_bat_command  "bash -c \"python3 -c \\\"import subprocess,re; out=subprocess.check_output(['pmset','-g','batt']).decode(); ac=('AC Power' in out and 'InternalBattery' not in out); batt=next((l for l in out.splitlines() if 'InternalBattery' in l),None); m=re.search(r'(\\\\\\\d+)%.*?(charging|discharging|charged|AC attached)',batt) if batt else None; pct=int(m.group(1)) if m else None; state=m.group(2).strip() if m else 'unknown'; icons=['󰂎','󰁺','󰁻','󰁼','󰁽','󰁾','󰁿','󰂀','󰂁','󰂂','󰁹']; print('󰚥' if (ac or pct is None) else ('󰂄 '+str(pct)+'%' if state=='charging' else ('󰁹 '+str(pct)+'%' if state in ('charged','AC attached') else (icons[min(pct//10,10)]+' '+str(pct)+'%'))))\\\"\""
                command_bat_interval "60"
                command_bat_rendermode "static"

                // Clock + date (Amsterdam timezone) — date before time, with day-of-week
                datetime_format    "󰸗 %a %d %b  󰥔 %H:%M"
                datetime_timezone  "Europe/Amsterdam"

                // ZJSTATUS_COLORS_BEGIN (managed by apply-theme-zellij — do not edit manually)
                // bg=#eff1f5 fg=#4c4f69 surface0=#ccd0da overlay1=#8c8fa1
                // subtext1=#5c5f77 blue=#1e66f5 sapphire=#209fb5 green=#40a02b
                // mauve=#8839ef peach=#fe640b yellow=#df8e1d red=#d20f39
                format_space  "#[bg=#eff1f5]"
                tab_normal         "#[fg=#8c8fa1,bg=#eff1f5] {index} {name} "
                tab_active         "#[fg=#4c4f69,bg=#ccd0da,bold] {index} {name} "
                tab_separator      "#[fg=#ccd0da,bg=#eff1f5]"
                mode_normal        "#[fg=#eff1f5,bg=#eff1f5] "
                mode_pane          "#[fg=#eff1f5,bg=#1e66f5,bold] PANE "
                mode_tab           "#[fg=#eff1f5,bg=#8839ef,bold] TAB "
                mode_scroll        "#[fg=#eff1f5,bg=#40a02b,bold] SCROLL "
                mode_search        "#[fg=#eff1f5,bg=#df8e1d,bold] SEARCH "
                mode_entersearch   "#[fg=#eff1f5,bg=#df8e1d,bold] SEARCH "
                mode_session       "#[fg=#eff1f5,bg=#209fb5,bold] SESSION "
                mode_move          "#[fg=#eff1f5,bg=#fe640b,bold] MOVE "
                mode_locked        "#[fg=#eff1f5,bg=#d20f39,bold] LOCKED "
                mode_resize        "#[fg=#eff1f5,bg=#df8e1d,bold] RESIZE "
                mode_renamepane    "#[fg=#eff1f5,bg=#df8e1d,bold] RENAME "
                mode_renametab     "#[fg=#eff1f5,bg=#df8e1d,bold] RENAME "
                command_weather_format   "#[fg=#209fb5,bg=#eff1f5] {stdout} "
                command_cpu_format       "#[fg=#40a02b,bg=#eff1f5] 󰻠 {stdout}% "
                command_mem_format       "#[fg=#8839ef,bg=#eff1f5] 󰍛 {stdout}M "
                command_bat_format       "#[fg=#df8e1d,bg=#eff1f5] {stdout} "
                datetime                 "#[fg=#5c5f77,bg=#eff1f5] {format} "
                // ZJSTATUS_COLORS_END
            }
        }

        children
    }
}
