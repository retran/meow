// @file: components/zellij/config/zellij/layouts/default.kdl
// @brief: Default zellij layout with zjstatus status bar at the top.
// @author: Andrew Vasilyev
// @license: MIT
//
// Prerequisites:
//   Download zjstatus.wasm from https://github.com/dj95/zjstatus/releases
//   and place it at ~/.config/zellij/plugins/zjstatus.wasm
//
//   The zjstatus-widgets Hammerspoon plugin must be installed and Hammerspoon
//   must be running.  It pushes all widget values (keyboard, VPN, battery,
//   CPU, memory, focus mode, date, time) as pipe events — no polling, no daemons.

layout {
    default_tab_template {
        // Status bar at the TOP (declared before children)
        pane size=2 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                format_center ""
                format_right  "{pipe_vpn}{pipe_focus}{pipe_cpu}{pipe_memory}{pipe_keyboard}{pipe_battery}{pipe_date}{pipe_time}"

                border_enabled  "false"
                hide_frame_for_single_pane "false"
                mode_default_to_mode "normal"

                // All widgets pushed by the zjstatus-widgets Hammerspoon plugin.
                // All use "dynamic" rendermode — colors are embedded in the piped
                // value by Lua so they update immediately on theme change.
                pipe_vpn_rendermode      "dynamic"
                pipe_focus_rendermode    "dynamic"
                pipe_keyboard_rendermode "dynamic"
                pipe_cpu_rendermode      "dynamic"
                pipe_memory_rendermode   "dynamic"
                pipe_battery_rendermode  "dynamic"
                pipe_date_rendermode     "dynamic"
                pipe_time_rendermode     "dynamic"

                // ZJSTATUS_COLORS_BEGIN (managed by apply-theme-zellij — do not edit manually)
                 // bg=#eff1f5 fg=#4c4f69 sel=#ccd0da dim=#8c8fa1 subtle=#5c5f77
                 // teal=#179299 blue=#1e66f5 mauve=#8839ef green=#40a02b
                 // yellow=#df8e1d orange=#fe640b red=#d20f39
                 format_left              "{mode}#[fg=#eff1f5,bg=#179299,bold] {session} #[fg=#179299,bg=#eff1f5]{tabs}"
                 format_space             "#[bg=#eff1f5]"
                 tab_normal               "#[fg=#8c8fa1,bg=#eff1f5] {index} {name} "
                 tab_active               "#[fg=#4c4f69,bg=#ccd0da,bold] {index} {name} "
                 tab_separator            "#[fg=#ccd0da,bg=#eff1f5]"
                 mode_normal              "#[fg=#8c8fa1,bg=#eff1f5] NORMAL "
                 mode_pane                "#[fg=#eff1f5,bg=#1e66f5,bold] PANE "
                 mode_tab                 "#[fg=#eff1f5,bg=#8839ef,bold] TAB "
                 mode_scroll              "#[fg=#eff1f5,bg=#40a02b,bold] SCROLL "
                 mode_search              "#[fg=#eff1f5,bg=#df8e1d,bold] SEARCH "
                 mode_enter_search        "#[fg=#eff1f5,bg=#df8e1d,bold] SEARCH "
                 mode_session             "#[fg=#eff1f5,bg=#179299,bold] SESSION "
                 mode_move                "#[fg=#eff1f5,bg=#fe640b,bold] MOVE "
                 mode_locked              "#[fg=#eff1f5,bg=#d20f39,bold] LOCKED "
                 mode_resize              "#[fg=#eff1f5,bg=#df8e1d,bold] RESIZE "
                 mode_rename_pane         "#[fg=#eff1f5,bg=#df8e1d,bold] RENAME "
                 mode_rename_tab          "#[fg=#eff1f5,bg=#df8e1d,bold] RENAME "
                 pipe_vpn_format          "{output}  "
                 pipe_focus_format        "{output}  "
                 pipe_keyboard_format     "{output}  "
                 pipe_cpu_format          "{output}  "
                 pipe_memory_format       "{output}  "
                 pipe_battery_format      "{output}  "
                 pipe_date_format         "{output}  "
                 pipe_time_format         "{output}"
                 // ZJSTATUS_COLORS_END
            }
        }

        children
    }
}
