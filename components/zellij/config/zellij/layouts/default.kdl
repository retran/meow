// @file: components/zellij/config/zellij/layouts/default.kdl
// @brief: Default zellij layout with zjstatus status bar at the top.
// @author: Andrew Vasilyev
// @license: MIT
//
// Prerequisites:
//   Download zjstatus.wasm from https://github.com/dj95/zjstatus/releases
//   and place it at ~/.config/zellij/plugins/zjstatus.wasm

layout {
    default_tab_template {
        // Status bar at the TOP (declared before children)
        pane size=2 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                format_center ""
                format_right  "{command_weather} {command_cpu} {command_mem} {command_bat} {datetime}"

                border_enabled  "false"
                hide_frame_for_single_pane "false"
                mode_default_to_mode "normal"

                // Weather via wttr.in (Amsterdam), refresh every 30 minutes
                command_weather_command  "bash -c \"$HOME/.config/zellij/scripts/zjstatus-weather\""
                command_weather_interval "1800"
                command_weather_rendermode "static"

                // CPU usage (macOS: top snapshot)
                command_cpu_command  "bash -c \"top -l 1 -s 0 | awk '/CPU usage/ {print $3}' | tr -d '%'\""
                command_cpu_interval "5"
                command_cpu_rendermode "static"

                // Memory usage (macOS: vm_stat)
                command_mem_command  "bash -c \"$HOME/.config/zellij/scripts/zjstatus-memory\""
                command_mem_interval "10"
                command_mem_rendermode "static"

                // Battery (macOS: pmset) — dynamic icon by level and charge state
                command_bat_command  "bash -c \"$HOME/.config/zellij/scripts/zjstatus-battery\""
                command_bat_interval "60"
                command_bat_rendermode "static"

                // Clock + date (Amsterdam timezone) — date before time, with day-of-week
                datetime_format    "󰸗 %a %d %b  󰥔 %H:%M"
                datetime_timezone  "Europe/Amsterdam"

                // ZJSTATUS_COLORS_BEGIN (managed by apply-theme-zellij — do not edit manually)
                 // bg=#1e1e2e fg=#cdd6f4 sel=#313244 dim=#7f849c subtle=#bac2de
                 // teal=#94e2d5 blue=#89b4fa mauve=#cba6f7 green=#a6e3a1
                 // yellow=#f9e2af orange=#fab387 red=#f38ba8
                 format_left              "{mode}#[fg=#1e1e2e,bg=#94e2d5,bold] {session} #[fg=#94e2d5,bg=#1e1e2e]{tabs}"
                 format_space             "#[bg=#1e1e2e]"
                 tab_normal               "#[fg=#7f849c,bg=#1e1e2e] {index} {name} "
                 tab_active               "#[fg=#cdd6f4,bg=#313244,bold] {index} {name} "
                 tab_separator            "#[fg=#313244,bg=#1e1e2e]"
                 mode_normal              "#[fg=#7f849c,bg=#1e1e2e] NORMAL "
                 mode_pane                "#[fg=#1e1e2e,bg=#89b4fa,bold] PANE "
                 mode_tab                 "#[fg=#1e1e2e,bg=#cba6f7,bold] TAB "
                 mode_scroll              "#[fg=#1e1e2e,bg=#a6e3a1,bold] SCROLL "
                 mode_search              "#[fg=#1e1e2e,bg=#f9e2af,bold] SEARCH "
                 mode_enter_search        "#[fg=#1e1e2e,bg=#f9e2af,bold] SEARCH "
                 mode_session             "#[fg=#1e1e2e,bg=#94e2d5,bold] SESSION "
                 mode_move                "#[fg=#1e1e2e,bg=#fab387,bold] MOVE "
                 mode_locked              "#[fg=#1e1e2e,bg=#f38ba8,bold] LOCKED "
                 mode_resize              "#[fg=#1e1e2e,bg=#f9e2af,bold] RESIZE "
                 mode_rename_pane         "#[fg=#1e1e2e,bg=#f9e2af,bold] RENAME "
                 mode_rename_tab          "#[fg=#1e1e2e,bg=#f9e2af,bold] RENAME "
                 command_weather_format   "#[fg=#94e2d5,bg=#1e1e2e] {stdout} "
                 command_cpu_format       "#[fg=#a6e3a1,bg=#1e1e2e] 󰻠 {stdout}% "
                 command_mem_format       "#[fg=#cba6f7,bg=#1e1e2e] {stdout} "
                 command_bat_format       "#[fg=#fab387,bg=#1e1e2e] {stdout} "
                 datetime                 "#[fg=#bac2de,bg=#1e1e2e] {format}"
                 // ZJSTATUS_COLORS_END
            }
        }

        children
    }
}
