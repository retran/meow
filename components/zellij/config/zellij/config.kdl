// ============================================================================
// GENERAL
// ============================================================================
mouse_mode true
scroll_buffer_size 50000
copy_on_select true
copy_command "pbcopy"
copy_clipboard "system"
pane_frames false
session_serialization false
default_shell "zsh"
default_layout "compact"

// ============================================================================
// THEME
// ============================================================================
theme "meow"

themes {
    meow {
        bg "#1f2335"
        fg "#c0caf5"
        black "#1d202f"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}

// ============================================================================
// KEY BINDINGS
// ============================================================================
// Ctrl-a is the leader. Press it to enter pane mode, then use the keys below.
// Esc, q, or Ctrl-a again to return to normal mode.
keybinds clear-defaults=true {

    normal {
        bind "Ctrl a" { SwitchToMode "Pane"; }
    }

    locked {
        bind "Ctrl a" { SwitchToMode "Normal"; }
    }

    pane {
        bind "Ctrl a" "Esc" "q" { SwitchToMode "Normal"; }

        // Focus
        bind "h" "Left"  { MoveFocus "Left";  SwitchToMode "Normal"; }
        bind "j" "Down"  { MoveFocus "Down";  SwitchToMode "Normal"; }
        bind "k" "Up"    { MoveFocus "Up";    SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // Split
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down";  SwitchToMode "Normal"; }

        // Resize
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }

        // Manage
        bind "x"     { CloseFocus; SwitchToMode "Normal"; }
        bind "z"     { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "Space" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "b"     { BreakPane; SwitchToMode "Normal"; }
        bind ">"     { MovePane "Right"; }
        bind "<"     { MovePane "Left"; }
        bind "Ctrl o" { MovePane; SwitchToMode "Normal"; }
        bind "="     { NextSwapLayout; SwitchToMode "Normal"; }
        bind "."     { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "g"     { SwitchToMode "Locked"; }

        // Tabs
        bind "c"           { NewTab; SwitchToMode "Normal"; }
        bind "X"           { CloseTab; SwitchToMode "Normal"; }
        bind "n"           { GoToNextTab; SwitchToMode "Normal"; }
        bind "p"           { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Alt l" "Alt Right" { GoToNextTab; SwitchToMode "Normal"; }
        bind "Alt h" "Alt Left"  { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Scroll
        bind "[" { SwitchToMode "Scroll"; }
        bind "f" { SwitchToMode "EnterSearch"; SearchInput 0; }

        // Session
        bind "d" { Detach; }
        bind "s" { SwitchToMode "Session"; }
        bind "Ctrl c" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }

        // Sync
        bind "Ctrl y" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
    }

    resize {
        bind "Ctrl a" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H"         { Resize "Decrease Left"; }
        bind "J"         { Resize "Decrease Down"; }
        bind "K"         { Resize "Decrease Up"; }
        bind "L"         { Resize "Decrease Right"; }
        bind "=" "+"     { Resize "Increase"; }
        bind "-"         { Resize "Decrease"; }
    }

    scroll {
        bind "Ctrl a" "Esc" "q" { SwitchToMode "Normal"; }
        bind "j" "Down"  { ScrollDown; }
        bind "k" "Up"    { ScrollUp; }
        bind "Ctrl d"    { HalfPageScrollDown; }
        bind "Ctrl u"    { HalfPageScrollUp; }
        bind "Ctrl f"    { PageScrollDown; }
        bind "Ctrl b"    { PageScrollUp; }
        bind "g"         { ScrollToTop; }
        bind "G"         { ScrollToBottom; }
        bind "y"         { Copy; SwitchToMode "Normal"; }
        bind "/"         { SwitchToMode "EnterSearch"; SearchInput 0; }
    }

    entersearch {
        bind "Ctrl a" "Esc" { SwitchToMode "Normal"; }
        bind "Enter"        { SwitchToMode "Search"; }
    }

    search {
        bind "Ctrl a" "Esc" { SwitchToMode "Normal"; }
        bind "Enter"        { SwitchToMode "Scroll"; }
        bind "n"            { Search "down"; }
        bind "N"            { Search "up"; }
        bind "c"            { SearchToggleOption "CaseSensitivity"; }
        bind "w"            { SearchToggleOption "WholeWord"; }
        bind "o"            { SearchToggleOption "Wrap"; }
    }

    tab {
        bind "Ctrl a" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left"  { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab; }
        bind "n"         { NewTab;   SwitchToMode "Normal"; }
        bind "x"         { CloseTab; SwitchToMode "Normal"; }
        bind "Tab"       { ToggleTab; }
        bind "s"         { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b"         { BreakPane;      SwitchToMode "Normal"; }
        bind "["         { BreakPaneLeft;  SwitchToMode "Normal"; }
        bind "]"         { BreakPaneRight; SwitchToMode "Normal"; }
        bind "H"         { MoveTab "Left"; }
        bind "L"         { MoveTab "Right"; }
        bind ","         { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    }

    renametab {
        bind "Enter"        { SwitchToMode "Normal"; }
        bind "Ctrl a" "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Enter"        { SwitchToMode "Normal"; }
        bind "Ctrl a" "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }

    move {
        bind "Ctrl a" "Esc" { SwitchToMode "Normal"; }
        bind "h" "Left"  { MovePane "Left"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "Tab"       { MovePane; }
    }

    session {
        bind "Ctrl a" "Esc" "q" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }
}
