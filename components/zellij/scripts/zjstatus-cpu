#!/usr/bin/env bash
# MIT License
#
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/zellij/scripts/zjstatus-cpu
# @brief: CPU usage widget for zjstatus — outputs integer percentage.
# @author: Andrew Vasilyev
# @license: MIT
#
# macOS: reads from `iostat -c 1` — single-sample, ~4 ms total.
#        iostat columns: us (user) + sy (system) summed by awk using the
#        header row to find column positions, so the output is robust to
#        varying numbers of disk columns.
# Linux: reads /proc/stat twice with a 0.2 s sleep for an accurate delta.
#        Pure bash arithmetic — no extra process spawns after the two reads.

if [[ "$(uname)" == "Darwin" ]]; then
    iostat -c 1 2>/dev/null | awk '
        NR==2 { for(i=1;i<=NF;i++) { if($i=="us") u=i; if($i=="sy") s=i } }
        NR==3 { if(u && s) { printf "%d\n", $u+$s } else { print "?" } }
    ' || printf '?\n'
else
    # Two-sample /proc/stat delta — bash builtins only after the two reads
    read_stat() {
        local fields
        read -r -a fields < /proc/stat
        # fields[0]=cpu fields[1..]=user nice system idle iowait irq softirq ...
        local idle=$(( fields[4] + ${fields[5]:-0} ))   # idle + iowait
        local total=0
        local f
        for f in "${fields[@]:1}"; do (( total += f )); done
        printf '%d %d' "$idle" "$total"
    }
    read -r idle1 total1 <<< "$(read_stat)"
    sleep 0.2
    read -r idle2 total2 <<< "$(read_stat)"
    d_total=$(( total2 - total1 ))
    d_idle=$(( idle2 - idle1 ))
    if (( d_total > 0 )); then
        printf '%d\n' $(( 100 * (d_total - d_idle) / d_total ))
    else
        printf '?\n'
    fi
fi
