# @file: components/zellij/scripts/zjstatus-battery
# @brief: Battery status widget for zjstatus — outputs icon + percentage.
# @author: Andrew Vasilyev
# @license: MIT
#
# macOS only — uses `pmset -g batt`.
# Icons (nf-md-battery series):
#   Charging:    󰂄
#   Full/AC:     󰁹
#   Discharging: 󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹  (0–9 %, 10–19 %, … 90–100 %)
#   AC only:     󰚥

ICONS_D=("󰂎" "󰁺" "󰁻" "󰁼" "󰁽" "󰁾" "󰁿" "󰂀" "󰂁" "󰂂" "󰁹")

out=$(pmset -g batt 2>/dev/null)

if [[ "$out" != *"InternalBattery"* ]]; then
    printf '󰚥\n'
    exit 0
fi

# Extract the InternalBattery line
line=$(grep "InternalBattery" <<< "$out")

# Extract percentage — first run of digits before '%'
[[ "$line" =~ ([0-9]+)% ]] || { printf '󰚥\n'; exit 0; }
pct="${BASH_REMATCH[1]}"

# Determine charge state via simple substring tests (avoids semicolon-in-regex issues)
if [[ "$line" == *"charging"* && "$line" != *"discharging"* ]]; then
    printf '󰂄 %d%%\n' "$pct"
elif [[ "$line" == *"charged"* || "$line" == *"AC attached"* ]]; then
    printf '󰁹 %d%%\n' "$pct"
else
    idx=$(( pct / 10 ))
    (( idx > 10 )) && idx=10
    printf '%s %d%%\n' "${ICONS_D[$idx]}" "$pct"
fi
