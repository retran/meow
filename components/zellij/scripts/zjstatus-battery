# @file: components/zellij/scripts/zjstatus-battery
# @brief: Battery status widget for zjstatus — outputs icon + percentage.
# @author: Andrew Vasilyev
# @license: MIT
#
# Icons by charge level (nf-md-battery series):
#   Charging:    󰂄
#   Full/AC:     󰁹
#   Discharging: 󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹  (0–10, 10–20, … 90–100)
#   AC only:     󰚥

import subprocess
import re
import sys

ICONS_DISCHARGING = ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
ICON_CHARGING = "󰂄"
ICON_FULL = "󰁹"
ICON_AC_ONLY = "󰚥"

try:
    out = subprocess.check_output(["pmset", "-g", "batt"], stderr=subprocess.DEVNULL).decode()
except Exception:
    print(ICON_AC_ONLY)
    sys.exit(0)

# No internal battery — desktop or closed-lid with AC only
if "InternalBattery" not in out:
    print(ICON_AC_ONLY)
    sys.exit(0)

batt_line = next((l for l in out.splitlines() if "InternalBattery" in l), None)
if not batt_line:
    print(ICON_AC_ONLY)
    sys.exit(0)

m = re.search(r"(\d+)%.*?(charging|discharging|charged|AC attached)", batt_line)
if not m:
    print(ICON_AC_ONLY)
    sys.exit(0)

pct = int(m.group(1))
state = m.group(2).strip()

if state == "charging":
    print(f"{ICON_CHARGING} {pct}%")
elif state in ("charged", "AC attached"):
    print(f"{ICON_FULL} {pct}%")
else:
    icon = ICONS_DISCHARGING[min(pct // 10, 10)]
    print(f"{icon} {pct}%")
