# @file: components/zellij/scripts/zjstatus-memory
# @brief: Memory usage widget for zjstatus — outputs used RAM in MiB.
# @author: Andrew Vasilyev
# @license: MIT
#
# macOS: reads from `vm_stat`
# Linux: reads from /proc/meminfo

import subprocess
import sys
import platform

def mem_macos() -> str:
    try:
        lines = subprocess.check_output(["vm_stat"], stderr=subprocess.DEVNULL).decode().splitlines()
        pages = {}
        for line in lines[1:]:
            if ":" in line:
                key, val = line.split(":", 1)
                try:
                    pages[key.strip()] = int(val.strip().rstrip("."))
                except ValueError:
                    pass
        used = (
            pages.get("Pages active", 0)
            + pages.get("Pages wired down", 0)
            + pages.get("Pages occupied by compressor", 0)
        ) * 4096 // 1048576
        return f"{used}M"
    except Exception:
        return "?"

def mem_linux() -> str:
    try:
        values = {}
        with open("/proc/meminfo") as f:
            for line in f:
                if ":" in line:
                    key, val = line.split(":", 1)
                    try:
                        values[key.strip()] = int(val.strip().split()[0])
                    except (ValueError, IndexError):
                        pass
        total    = values.get("MemTotal", 0)
        free     = values.get("MemFree", 0)
        buffers  = values.get("Buffers", 0)
        cached   = values.get("Cached", 0)
        s_cached = values.get("SwapCached", 0)
        used_kb  = total - free - buffers - cached - s_cached
        used_mib = max(0, used_kb) // 1024
        return f"{used_mib}M"
    except Exception:
        return "?"

if platform.system() == "Darwin":
    print(f"󰍛 {mem_macos()}")
else:
    print(f"󰍛 {mem_linux()}")
