# @file: components/zellij/scripts/zjstatus-memory
# @brief: Memory usage widget for zjstatus — outputs used RAM in MiB.
# @author: Andrew Vasilyev
# @license: MIT

import subprocess
import sys

try:
    lines = subprocess.check_output(["vm_stat"], stderr=subprocess.DEVNULL).decode().splitlines()
    pages = {}
    for line in lines[1:]:
        if ":" in line:
            key, val = line.split(":", 1)
            try:
                pages[key.strip()] = int(val.strip().rstrip("."))
            except ValueError:
                pass
    used = (
        pages.get("Pages active", 0)
        + pages.get("Pages wired down", 0)
        + pages.get("Pages occupied by compressor", 0)
    ) * 4096 // 1048576
    print(f"󰍛 {used}M")
except Exception:
    print("󰍛 ?")
    sys.exit(0)
