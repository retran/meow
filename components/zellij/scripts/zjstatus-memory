#!/usr/bin/env bash
# MIT License
#
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/zellij/scripts/zjstatus-memory
# @brief: Memory usage widget for zjstatus — outputs used RAM in MiB.
# @author: Andrew Vasilyev
# @license: MIT
#
# macOS: reads `vm_stat` and accumulates active + wired + compressor pages.
#        Page size is read from the header line; on Apple Silicon it is
#        16 384 bytes (not the legacy 4 096).  All arithmetic via bash builtins.
# Linux: reads /proc/meminfo with a single `read` loop — no subshells.

if [[ "$(uname)" == "Darwin" ]]; then
    page_size=16384   # default; overridden by header if present
    active=0 wired=0 comp=0

    while IFS=: read -r key val; do
        val="${val//[. ]/}"   # strip dots (trailing period) and spaces
        case "$key" in
            "Mach Virtual Memory Statistics"*)
                # Header: "Mach Virtual Memory Statistics: (page size of 16384 bytes)"
                [[ "$key$val" =~ page\ size\ of\ ([0-9]+) ]] && page_size="${BASH_REMATCH[1]}"
                ;;
            "Pages active")                       active=$val ;;
            "Pages wired down")                   wired=$val  ;;
            "Pages occupied by compressor")       comp=$val   ;;
        esac
    done < <(vm_stat 2>/dev/null)

    used_bytes=$(( (active + wired + comp) * page_size ))
    printf '󰍛 %dM\n' $(( used_bytes / 1048576 ))
else
    total=0 free=0 buffers=0 cached=0 s_cached=0

    while IFS=: read -r key val; do
        # val is like "  1234 kB" — extract the number
        val="${val%%[^0-9]*}"   # drop everything after the digits
        val="${val##* }"        # trim leading spaces (bash builtin)
        case "$key" in
            MemTotal)    total=$val    ;;
            MemFree)     free=$val     ;;
            Buffers)     buffers=$val  ;;
            Cached)      cached=$val   ;;
            SwapCached)  s_cached=$val ;;
        esac
    done < /proc/meminfo

    used_kb=$(( total - free - buffers - cached - s_cached ))
    (( used_kb < 0 )) && used_kb=0
    printf '󰍛 %dM\n' $(( used_kb / 1024 ))
fi
