#!/usr/bin/env bash
# MIT License
# Copyright (c) 2025 Andrew Vasilyev <me@retran.me>
#
# @file: components/zellij/scripts/apply-theme-zellij
# @brief: Apply a Zellij theme by writing meow-light.kdl or meow-dark.kdl
# @author: Andrew Vasilyev
# @license: MIT
#
# Copies the matching pre-built preset from theme-presets/ into themes/ as
# meow-light.kdl or meow-dark.kdl (with the internal theme key renamed to
# match), then rewrites the `theme` line in config.kdl to point at the
# correct name.  Both meow-light and meow-dark can coexist in themes/ without
# key collisions.
#
# Note: zellij does not support live theme reload for running sessions
# (upstream issue #3879). The new theme takes effect for new sessions
# and on next attach.

set -euo pipefail

PRESET="${1:-}"
VARIANT="${2:-}"
MODE="${3:-}"

if [[ -z "$PRESET" || -z "$VARIANT" ]]; then
  echo "Usage: $0 <preset> <variant> [light|dark]" >&2
  exit 1
fi

MEOW_ROOT="${MEOW:-$HOME/.meow}"
THEME_LIB="${THEME_LIB:-$MEOW_ROOT/lib/theme/theme.sh}"
THEME_UTILS="${THEME_UTILS:-$MEOW_ROOT/lib/theme/theme-utils.sh}"

if [[ ! -f "$THEME_UTILS" ]]; then
  echo "Theme utilities not found: $THEME_UTILS" >&2
  exit 1
fi

if [[ ! -f "$THEME_LIB" ]]; then
  echo "Theme library not found: $THEME_LIB" >&2
  exit 1
fi

source "$THEME_LIB"
source "$THEME_UTILS"

preset_slug=$(theme_slugify "$PRESET")
variant_slug=$(theme_slugify "$VARIANT")

presets_dir="$MEOW_ROOT/components/zellij/config/theme-presets"
themes_dir="$MEOW_ROOT/components/zellij/config/themes"
config_kdl="$MEOW_ROOT/components/zellij/config/zellij/config.kdl"

src="$presets_dir/${preset_slug}-${variant_slug}.kdl"

if [[ ! -f "$src" ]]; then
  echo "Zellij theme not found: $src" >&2
  exit 1
fi

# ── Determine light or dark ───────────────────────────────────────────────────

# Use the mode arg if provided; otherwise fall back to background brightness.
if [[ "$MODE" == "light" || "$MODE" == "dark" ]]; then
  mode="$MODE"
else
  bg_hex=$(theme_get_palette_color "$PRESET" "$VARIANT" "bg" 2>/dev/null \
        || theme_get_palette_color "$PRESET" "$VARIANT" "base" 2>/dev/null \
        || true)
  bg_hex="${bg_hex#\#}"
  mode="dark"
  if [[ ${#bg_hex} -eq 6 ]]; then
    r=$(( 16#${bg_hex:0:2} ))
    g=$(( 16#${bg_hex:2:2} ))
    b=$(( 16#${bg_hex:4:2} ))
    lum=$(( (299 * r + 587 * g + 114 * b) / 1000 ))
    if (( lum > 128 )); then
      mode="light"
    fi
  fi
fi

theme_name="meow-${mode}"
dest="$themes_dir/${theme_name}.kdl"

# ── Write theme file ──────────────────────────────────────────────────────────

# Copy preset and rename the internal theme key from "meow" to "meow-light"
# or "meow-dark" so zellij resolves it under the correct name.
sed "s/^    meow {$/    ${theme_name} {/" "$src" > "$dest"

# ── Rewrite theme line in config.kdl ─────────────────────────────────────────

if [[ ! -f "$config_kdl" ]]; then
  echo "config.kdl not found: $config_kdl" >&2
  exit 1
fi

sed -i.bak "s|^theme \"meow.*\"|theme \"${theme_name}\"|" "$config_kdl"
rm -f "${config_kdl}.bak"

# ── Rewrite zjstatus color block in default.kdl ───────────────────────────────

layout_kdl="$MEOW_ROOT/components/zellij/config/zellij/layouts/default.kdl"
layout_kdl_installed="$MEOW_ROOT/.installed/components/zellij/config/zellij/layouts/default.kdl"

if [[ -f "$layout_kdl" ]]; then
  # Resolve palette colors (same logic as generate-theme-zellij)
  get_color() {
    local result=""
    for key in "$@"; do
      result=$(theme_get_palette_color "$PRESET" "$VARIANT" "$key" 2>/dev/null || true)
      if [[ -n "$result" && "$result" != "null" ]]; then
        echo "$result"
        return
      fi
    done
    echo ""
  }

  # ── Semantic color roles ─────────────────────────────────────────────────────
  # bar background / foreground
  _bg=$(get_color "bg" "base" "bg1")
  _fg=$(get_color "fg" "text" "fg1")

  # selection: active tab background
  _sel=$(get_color "surface0" "bg_highlight" "bg_visual" "sel0" "bg1" "bg2" "mantle")

  # dimmed: normal tab fg, datetime, normal mode indicator
  _dim=$(get_color "overlay1" "comment" "gray" "subtext0" "fg_gutter" "dark5")

  # subtle: datetime text (slightly lighter than dim)
  _subtle=$(get_color "subtext1" "overlay2" "comment" "gray" "fg_gutter")

  # identity/accent: session pill — teal/cyan family
  _teal=$(get_color "teal" "cyan" "sapphire" "water" "foam" "pine" "sky")

  # pane mode — blue family
  _blue=$(get_color "blue" "water" "sapphire" "sky" "blue0" "pine" "foam")

  # tab mode — purple/mauve family
  _mauve=$(get_color "mauve" "purple" "magenta" "blossom" "iris" "violet" "pink")

  # scroll / cpu widget — green family
  _green=$(get_color "green" "leaf" "teal" "pine" "green1")

  # search / resize / rename / battery — yellow/amber family
  _yellow=$(get_color "yellow" "gold" "wood" "peach" "orange" "highlight")

  # move mode / battery — orange family
  _orange=$(get_color "orange" "peach" "wood" "yellow" "gold" "highlight")

  # locked mode — red family
  _red=$(get_color "red" "love" "rose" "danger" "error" "maroon")

  # ── Fallbacks to fg/bg for anything unresolved ───────────────────────────────
  [[ -z "$_sel"    ]] && _sel="$_bg"
  [[ -z "$_dim"    ]] && _dim="$_fg"
  [[ -z "$_subtle" ]] && _subtle="$_fg"
  [[ -z "$_teal"   ]] && _teal="$_fg"
  [[ -z "$_blue"   ]] && _blue="$_fg"
  [[ -z "$_mauve"  ]] && _mauve="$_fg"
  [[ -z "$_green"  ]] && _green="$_fg"
  [[ -z "$_yellow" ]] && _yellow="$_fg"
  [[ -z "$_orange" ]] && _orange="$_fg"
  [[ -z "$_red"    ]] && _red="$_fg"

  if [[ -n "$_bg" && -n "$_fg" ]]; then
    # Build the replacement block — only color-bearing values, no command strings
    new_block="                // ZJSTATUS_COLORS_BEGIN (managed by apply-theme-zellij — do not edit manually)
                 // bg=${_bg} fg=${_fg} sel=${_sel} dim=${_dim} subtle=${_subtle}
                 // teal=${_teal} blue=${_blue} mauve=${_mauve} green=${_green}
                 // yellow=${_yellow} orange=${_orange} red=${_red}
                 format_left              \"{mode}#[fg=${_bg},bg=${_teal},bold] {session} #[fg=${_teal},bg=${_bg}]{tabs}\"
                 format_space             \"#[bg=${_bg}]\"
                 tab_normal               \"#[fg=${_dim},bg=${_bg}] {index} {name} \"
                 tab_active               \"#[fg=${_fg},bg=${_sel},bold] {index} {name} \"
                 tab_separator            \"#[fg=${_sel},bg=${_bg}]\"
                 mode_normal              \"#[fg=${_dim},bg=${_bg}] NORMAL \"
                 mode_pane                \"#[fg=${_bg},bg=${_blue},bold] PANE \"
                 mode_tab                 \"#[fg=${_bg},bg=${_mauve},bold] TAB \"
                 mode_scroll              \"#[fg=${_bg},bg=${_green},bold] SCROLL \"
                 mode_search              \"#[fg=${_bg},bg=${_yellow},bold] SEARCH \"
                 mode_enter_search        \"#[fg=${_bg},bg=${_yellow},bold] SEARCH \"
                 mode_session             \"#[fg=${_bg},bg=${_teal},bold] SESSION \"
                 mode_move                \"#[fg=${_bg},bg=${_orange},bold] MOVE \"
                 mode_locked              \"#[fg=${_bg},bg=${_red},bold] LOCKED \"
                 mode_resize              \"#[fg=${_bg},bg=${_yellow},bold] RESIZE \"
                 mode_rename_pane         \"#[fg=${_bg},bg=${_yellow},bold] RENAME \"
                 mode_rename_tab          \"#[fg=${_bg},bg=${_yellow},bold] RENAME \"
                 command_weather_format   \"#[fg=${_teal},bg=${_bg}] {stdout} \"
                 command_cpu_format       \"#[fg=${_green},bg=${_bg}] 󰻠 {stdout}% \"
                 command_mem_format       \"#[fg=${_mauve},bg=${_bg}] {stdout} \"
                 command_bat_format       \"#[fg=${_orange},bg=${_bg}] {stdout} \"
                 datetime                 \"#[fg=${_subtle},bg=${_bg}] {format}\"
                 // ZJSTATUS_COLORS_END"

    # Replace everything between the sentinel comments (inclusive) in both source and installed
    python3 - "$layout_kdl" "$layout_kdl_installed" "$new_block" <<'PYEOF'
import sys, re

layout_files = sys.argv[1:-1]
new_block = sys.argv[-1]

pattern = r'[ \t]*// ZJSTATUS_COLORS_BEGIN.*?// ZJSTATUS_COLORS_END'

for layout_file in layout_files:
    import os
    if not os.path.isfile(layout_file):
        continue
    with open(layout_file, 'r') as f:
        content = f.read()
    if not re.search(pattern, content, flags=re.DOTALL):
        print(f"Warning: ZJSTATUS_COLORS_BEGIN/END sentinels not found in {layout_file}", file=sys.stderr)
    else:
        new_content = re.sub(pattern, new_block, content, flags=re.DOTALL)
        with open(layout_file, 'w') as f:
            f.write(new_content)
        print(f"Updated zjstatus colors in {layout_file}")
PYEOF
  else
    echo "Warning: could not resolve bg/fg colors for zjstatus, skipping layout update" >&2
  fi
fi

echo "Applied Zellij theme: $PRESET/$VARIANT (${theme_name})"
