# @file: components/zellij/scripts/zjstatus-weather
# @brief: Weather widget for zjstatus — outputs wttr.in icon + temperature,
#         with runs of spaces collapsed to one.
# @author: Andrew Vasilyev
# @license: MIT
#
# Location is read from the ZJSTATUS_WEATHER_LOCATION environment variable.
# If not set, defaults to "Amsterdam".  Override it in ~/.zshrc or
# ~/.config/zellij/env (or any file sourced before zellij starts).

import os
import subprocess
import re
import sys

LOCATION = os.environ.get("ZJSTATUS_WEATHER_LOCATION", "Amsterdam")

try:
    out = subprocess.check_output(
        ["curl", "-s", f"wttr.in/{LOCATION}?format=1"],
        stderr=subprocess.DEVNULL,
    ).decode().strip()
    # Collapse multiple spaces (emoji padding) to a single space
    out = re.sub(r"  +", " ", out)
    print(out)
except Exception:
    print("?")
    sys.exit(0)
